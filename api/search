23":5,"124":5,"125":5,"126":5,"127":5,"128":5,"129":5,"130":4,"131":4,"132":5,"133":5,"134":5,"135":4,"136":5,"137":5,"138":5,"139":5,"140":5,"141":5,"142":5,"143":5,"144":5,"145":5,"146":5,"147":5,"148":5,"149":4,"150":4,"151":5,"152":5,"153":5,"154":4,"155":5,"156":5,"157":5,"158":5,"159":5,"160":5,"161":5,"162":5,"163":5,"164":5,"165":4,"166":4,"167":5,"168":5,"169":5,"170":4,"171":5,"172":5,"173":5,"174":5,"175":5,"176":5,"177":5,"178":4,"179":4,"180":5,"181":5,"182":5,"183":4,"184":5,"185":5,"186":5,"187":5,"188":5,"189":5,"190":5,"191":5,"192":4,"193":4,"194":5,"195":5,"196":5,"197":4,"198":5,"199":5,"200":5,"201":5,"202":5,"203":5,"204":5,"205":5,"206":4,"207":4,"208":5,"209":5,"210":5,"211":4,"212":5,"213":5,"214":5,"215":5,"216":5,"217":5,"218":5,"219":4,"220":4,"221":5,"222":5,"223":5,"224":4,"225":5,"226":5,"227":5,"228":5,"229":5,"230":5,"231":3,"232":3,"233":4,"234":4,"235":4,"236":3,"237":4,"238":4,"239":4,"240":4,"241":4,"242":4,"243":4,"244":4,"245":3,"246":3,"247":4,"248":4,"249":4,"250":3,"251":4,"252":4,"253":4,"254":4,"255":4,"256":4,"257":4,"258":4,"259":3,"260":3,"261":4,"262":4,"263":4,"264":3,"265":4,"266":4,"267":4,"268":4,"269":4,"270":4,"271":4,"272":4,"273":4,"274":4,"275":5,"276":5,"277":5,"278":4,"279":5,"280":5,"281":5,"282":5,"283":5,"284":5,"285":5,"286":5,"287":5,"288":5,"289":4,"290":4,"291":5,"292":5,"293":5,"294":4,"295":5,"296":5,"297":5,"298":5,"299":5,"300":5,"301":5,"302":5,"303":1,"304":1,"305":5,"306":2,"307":2,"308":3,"309":1,"310":1,"311":5,"312":5,"313":5,"314":5,"315":5,"316":2,"317":2,"318":2,"319":2,"320":2,"321":2,"322":2,"323":2,"324":2,"325":3,"326":3,"327":3}}},"docs":{"docs":{"1":{"id":"/docs/components/action-log","page_id":"/docs/components/action-log","type":"page","content":"Action log","breadcrumbs":["Docs","Components","Agent status"],"tags":[],"url":"/docs/components/action-log"},"2":{"id":"/docs/components/action-log-0","page_id":"/docs/components/action-log","tags":[],"type":"text","url":"/docs/components/action-log","content":"Every tool call the agent makes, as a list that grows while it works, where each row opens to show its output."},"3":{"id":"/docs/components/action-log-1","page_id":"/docs/components/action-log","type":"heading","tags":[],"url":"/docs/components/action-log#usage","content":"Usage"},"4":{"id":"/docs/components/action-log-2","page_id":"/docs/components/action-log","type":"heading","tags":[],"url":"/docs/components/action-log#properties","content":"Properties"},"5":{"id":"/docs/components/action-log-3","page_id":"/docs/components/action-log","type":"heading","tags":[],"url":"/docs/components/action-log#theming","content":"Theming"},"6":{"id":"/docs/components/action-log-4","page_id":"/docs/components/action-log","tags":[],"type":"text","url":"/docs/components/action-log","content":"An action log is a streaming list of what the agent does: each read, search, edit or command\nlands as a row, running with a spinner, then done with a check and the time it took. A row with\noutput opens to show it, like a diff or test run. The header shows a spinner while the run is live\nand a green dot once it finishes."},"7":{"id":"/docs/components/action-log-5","page_id":"/docs/components/action-log","tags":[],"type":"text","url":"/docs/components/action-log#properties","content":"| Name      | Type       | Description                                                                                                                                                      |\n| --------- | ---------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `actions` | `Action[]` | The tool calls, newest at the end. Each has an `icon`, a `title`, an optional `detail`, a `state` of running or done, an optional `time`, and optional `output`. |","table":"table-0"},"8":{"id":"/docs/components/action-log-6","page_id":"/docs/components/action-log","tags":[],"type":"text","url":"/docs/components/action-log#properties","content":"| Name    | Type     | Description                                    |\n| ------- | -------- | ---------------------------------------------- |\n| `title` | `string` | The header text. Defaults to \"Agent activity\". |","table":"table-0"},"9":{"id":"/docs/components/action-log-7","page_id":"/docs/components/action-log","tags":[],"type":"text","url":"/docs/components/action-log#properties","content":"| Name      | Type      | Description                                                           |\n| --------- | --------- | --------------------------------------------------------------------- |\n| `running` | `boolean` | Shows a spinner in the header while true, and a green dot once false. |","table":"table-0"},"10":{"id":"/docs/components/action-log-8","page_id":"/docs/components/action-log","tags":[],"type":"text","url":"/docs/components/action-log#properties","content":"| Name     | Type     | Description                                                                         |\n| -------- | -------- | ----------------------------------------------------------------------------------- |\n| `status` | `string` | The words beside the header mark. Defaults to \"Running step N\", then \"N steps, Xs\". |","table":"table-0"},"11":{"id":"/docs/components/action-log-9","page_id":"/docs/components/action-log","tags":[],"type":"text","url":"/docs/components/action-log#properties","content":"| Name   | Type      | Description                                                                       |\n| ------ | --------- | --------------------------------------------------------------------------------- |\n| `bare` | `boolean` | Sits flat in a chat thread (the default). Set false to give it a card of its own. |","table":"table-0"},"12":{"id":"/docs/components/action-log-10","page_id":"/docs/components/action-log","tags":[],"type":"text","url":"/docs/components/action-log#properties","content":"| Name                     | Type       | Description                       |\n| ------------------------ | ---------- | --------------------------------- |\n| `onToggle` / `toggleRow` | `callback` | Fires when a row opens or closes. |","table":"table-0"},"13":{"id":"/docs/components/action-log-11","page_id":"/docs/components/action-log","tags":[],"type":"text","url":"/docs/components/action-log#theming","content":"Works in light and dark (`data-theme=\"dark\"`) and in the Soft style (`data-style=\"soft\"`). In\nBlueprint the rows and the output panes are squared off with hairline edges; in Soft they are\nrounded chips with soft fills. Added and removed lines in a row's output take the add and remove\ncolors from the tokens."},"14":{"id":"/docs/components/agent-phases","page_id":"/docs/components/agent-phases","type":"page","content":"Agent phases","breadcrumbs":["Docs","Components","Agent status"],"tags":[],"url":"/docs/components/agent-phases"},"15":{"id":"/docs/components/agent-phases-0","page_id":"/docs/components/agent-phases","tags":[],"type":"text","url":"/docs/components/agent-phases","content":"One line for which phase an agent is in, from thinking to done, that stops to ask, says when it is slow, and folds to how long it took."},"16":{"id":"/docs/components/agent-phases-1","page_id":"/docs/components/agent-phases","type":"heading","tags":[],"url":"/docs/components/agent-phases#usage","content":"Usage"},"17":{"id":"/docs/components/agent-phases-2","page_id":"/docs/components/agent-phases","type":"heading","tags":[],"url":"/docs/components/agent-phases#properties","content":"Properties"},"18":{"id":"/docs/components/agent-phases-3","page_id":"/docs/components/agent-phases","type":"heading","tags":[],"url":"/docs/components/agent-phases#theming","content":"Theming"},"19":{"id":"/docs/components/agent-phases-4","page_id":"/docs/components/agent-phases","tags":[],"type":"text","url":"/docs/components/agent-phases","content":"Agent phases show which phase the agent is in, in one line: its glyph, its name shimmering while the\nphase lasts, and the seconds so far, with a track of six short segments under it that fills phase by\nphase. When the agent needs you, is slow or fails, a line under the track says so with what to do;\nonce it is done the line reads how long it took and opens to the phases it ran through."},"20":{"id":"/docs/components/agent-phases-5","page_id":"/docs/components/agent-phases","tags":[],"type":"text","url":"/docs/components/agent-phases#properties","content":"| Name    | Type                                                             | Description                  |\n| ------- | ---------------------------------------------------------------- | ---------------------------- |\n| `phase` | `thinking \\| searching \\| reading \\| waiting \\| writing \\| done` | Which phase the agent is in. |","table":"table-0"},"21":{"id":"/docs/components/agent-phases-6","page_id":"/docs/components/agent-phases","tags":[],"type":"text","url":"/docs/components/agent-phases#properties","content":"| Name    | Type     | Description                                                                     |\n| ------- | -------- | ------------------------------------------------------------------------------- |\n| `label` | `string` | What the line says. Defaults to the phase's name; once done, \"Thought for 12s\". |","table":"table-0"},"22":{"id":"/docs/components/agent-phases-7","page_id":"/docs/components/agent-phases","tags":[],"type":"text","url":"/docs/components/agent-phases#properties","content":"| Name      | Type     | Description                                                                       |\n| --------- | -------- | --------------------------------------------------------------------------------- |\n| `seconds` | `number` | Seconds so far. Counts by itself while left out, and stops while waiting for you. |","table":"table-0"},"23":{"id":"/docs/components/agent-phases-8","page_id":"/docs/components/agent-phases","tags":[],"type":"text","url":"/docs/components/agent-phases#properties","content":"| Name    | Type     | Description                                                                                                   |\n| ------- | -------- | ------------------------------------------------------------------------------------------------------------- |\n| `error` | `object` | A step that failed: the line turns red and says so, with Retry. Has `text`, optional `detail`, and `onRetry`. |","table":"table-0"},"24":{"id":"/docs/components/agent-phases-9","page_id":"/docs/components/agent-phases","tags":[],"type":"text","url":"/docs/components/agent-phases#properties","content":"| Name   | Type     | Description                                                                       |\n| ------ | -------- | --------------------------------------------------------------------------------- |\n| `slow` | `object` | Shown while the phase takes long, with Stop. Has `text` and an optional `onStop`. |","table":"table-0"},"25":{"id":"/docs/components/agent-phases-10","page_id":"/docs/components/agent-phases","tags":[],"type":"text","url":"/docs/components/agent-phases#properties","content":"| Name  | Type     | Description                                                                                                               |\n| ----- | -------- | ------------------------------------------------------------------------------------------------------------------------- |\n| `ask` | `object` | What the agent waits for in the waiting phase. Has `text`, optional `approveLabel`, `onApprove` and optional `onDecline`. |","table":"table-0"},"26":{"id":"/docs/components/agent-phases-11","page_id":"/docs/components/agent-phases","tags":[],"type":"text","url":"/docs/components/agent-phases#properties","content":"| Name   | Type                    | Description                                                     |\n| ------ | ----------------------- | --------------------------------------------------------------- |\n| `took` | `Record<phase, number>` | Seconds each phase took, for the list a finished line opens to. |","table":"table-0"},"27":{"id":"/docs/components/agent-phases-12","page_id":"/docs/components/agent-phases","tags":[],"type":"text","url":"/docs/components/agent-phases#properties","content":"| Name                   | Type      | Description                                                                      |\n| ---------------------- | --------- | -------------------------------------------------------------------------------- |\n| `open` / `defaultOpen` | `boolean` | Whether the finished line is open. Leave `open` out to let the header toggle it. |","table":"table-0"},"28":{"id":"/docs/components/agent-phases-13","page_id":"/docs/components/agent-phases","tags":[],"type":"text","url":"/docs/components/agent-phases#theming","content":"Works in light and dark (`data-theme=\"dark\"`) and in the Soft style (`data-style=\"soft\"`). The glyph\nand the current segment take the phase's colour — the accent while it works, amber while it waits,\nred on an error and green when done. In Blueprint the segments are squared off and the shimmer rests\non a solid colour."},"29":{"id":"/docs/components/badge","page_id":"/docs/components/badge","type":"page","content":"Badge","breadcrumbs":["Docs","Components","Forms and inputs"],"tags":[],"url":"/docs/components/badge"},"30":{"id":"/docs/components/badge-0","page_id":"/docs/components/badge","tags":[],"type":"text","url":"/docs/components/badge","content":"A small label for a plan, environment, or status, with an optional dot or icon and an optional remove button."},"31":{"id":"/docs/components/badge-1","page_id":"/docs/components/badge","type":"heading","tags":[],"url":"/docs/components/badge#usage","content":"Usage"},"32":{"id":"/docs/components/badge-2","page_id":"/docs/components/badge","type":"heading","tags":[],"url":"/docs/components/badge#properties","content":"Properties"},"33":{"id":"/docs/components/badge-3","page_id":"/docs/components/badge","type":"heading","tags":[],"url":"/docs/components/badge#theming","content":"Theming"},"34":{"id":"/docs/components/badge-4","page_id":"/docs/components/badge","tags":[],"type":"text","url":"/docs/components/badge","content":"A badge is a compact label. Its `tone` picks the color (neutral, the accent tint, the three\nstates, or one of eight tag colors). Two sizes, an optional dot or icon before the label, and an\noptional remove button after it."},"35":{"id":"/docs/components/badge-5","page_id":"/docs/components/badge","tags":[],"type":"text","url":"/docs/components/badge#properties","content":"| Name   | Type                                                                                                                      | Description                                        |\n| ------ | ------------------------------------------------------------------------------------------------------------------------- | -------------------------------------------------- |\n| `tone` | `neutral \\| accent \\| success \\| warning \\| danger \\| blue \\| violet \\| green \\| orange \\| red \\| yellow \\| pink \\| teal` | Color as text on its own tint. Neutral by default. |","table":"table-0"},"36":{"id":"/docs/components/badge-6","page_id":"/docs/components/badge","tags":[],"type":"text","url":"/docs/components/badge#properties","content":"| Name   | Type       | Description                                    |\n| ------ | ---------- | ---------------------------------------------- |\n| `size` | `sm \\| md` | `sm` is 20px tall, `md` is 24px (the default). |","table":"table-0"},"37":{"id":"/docs/components/badge-7","page_id":"/docs/components/badge","tags":[],"type":"text","url":"/docs/components/badge#properties","content":"| Name  | Type      | Description                                  |\n| ----- | --------- | -------------------------------------------- |\n| `dot` | `boolean` | A dot in the badge's color before the label. |","table":"table-0"},"38":{"id":"/docs/components/badge-8","page_id":"/docs/components/badge","tags":[],"type":"text","url":"/docs/components/badge#properties","content":"| Name   | Type       | Description               |\n| ------ | ---------- | ------------------------- |\n| `icon` | `IconName` | An icon before the label. |","table":"table-0"},"39":{"id":"/docs/components/badge-9","page_id":"/docs/components/badge","tags":[],"type":"text","url":"/docs/components/badge#properties","content":"| Name                  | Type       | Description                            |\n| --------------------- | ---------- | -------------------------------------- |\n| `onRemove` / `remove` | `callback` | Shows a remove button after the label. |","table":"table-0"},"40":{"id":"/docs/components/badge-10","page_id":"/docs/components/badge","tags":[],"type":"text","url":"/docs/components/badge#theming","content":"Works in light and dark (`data-theme=\"dark\"`) and in the Soft style (`data-style=\"soft\"`). In\nBlueprint the badge is squared off and set in small caps with a hairline in its own color; in Soft\nit is a pill."},"41":{"id":"/docs/components/browser-session","page_id":"/docs/components/browser-session","type":"page","content":"Browser session","breadcrumbs":["Docs","Components","Agent status"],"tags":[],"url":"/docs/components/browser-session"},"42":{"id":"/docs/components/browser-session-0","page_id":"/docs/components/browser-session","tags":[],"type":"text","url":"/docs/components/browser-session","content":"The agent browsing the web for you step by step, in a small browser frame with the steps it takes, and Pause and Take over."},"43":{"id":"/docs/components/browser-session-1","page_id":"/docs/components/browser-session","type":"heading","tags":[],"url":"/docs/components/browser-session#usage","content":"Usage"},"44":{"id":"/docs/components/browser-session-2","page_id":"/docs/components/browser-session","type":"heading","tags":[],"url":"/docs/components/browser-session#properties","content":"Properties"},"45":{"id":"/docs/components/browser-session-3","page_id":"/docs/components/browser-session","type":"heading","tags":[],"url":"/docs/components/browser-session#theming","content":"Theming"},"46":{"id":"/docs/components/browser-session-4","page_id":"/docs/components/browser-session","tags":[],"type":"text","url":"/docs/components/browser-session","content":"A browser session shows the agent browsing the web for you: a small browser frame with the page it\nis on, the steps it takes under it, and Pause and Take over. When a step waits for you — a cookie\nbanner in the way, say — it shows why and a button to let the agent go on. Take over hands the page\nto you: its frame turns the accent colour, its controls become usable, and the button reads Hand\nback."},"47":{"id":"/docs/components/browser-session-5","page_id":"/docs/components/browser-session","tags":[],"type":"text","url":"/docs/components/browser-session#properties","content":"| Name    | Type     | Description                                              |\n| ------- | -------- | -------------------------------------------------------- |\n| `title` | `string` | What the agent is browsing for, like \"Pricing research\". |","table":"table-0"},"48":{"id":"/docs/components/browser-session-6","page_id":"/docs/components/browser-session","tags":[],"type":"text","url":"/docs/components/browser-session#properties","content":"| Name  | Type     | Description                                                     |\n| ----- | -------- | --------------------------------------------------------------- |\n| `url` | `string` | The address bar: the page's address, or the search being typed. |","table":"table-0"},"49":{"id":"/docs/components/browser-session-7","page_id":"/docs/components/browser-session","tags":[],"type":"text","url":"/docs/components/browser-session#properties","content":"| Name     | Type      | Description                                                       |\n| -------- | --------- | ----------------------------------------------------------------- |\n| `search` | `boolean` | Marks `url` as a search, with a magnifier instead of the padlock. |","table":"table-0"},"50":{"id":"/docs/components/browser-session-8","page_id":"/docs/components/browser-session","tags":[],"type":"text","url":"/docs/components/browser-session#properties","content":"| Name    | Type            | Description                                                                                                                     |\n| ------- | --------------- | ------------------------------------------------------------------------------------------------------------------------------- |\n| `steps` | `BrowserStep[]` | The steps the agent takes. Each has a `label`, a `state` of `queued`, `running`, `waiting` or `done`, and an optional `detail`. |","table":"table-0"},"51":{"id":"/docs/components/browser-session-9","page_id":"/docs/components/browser-session","tags":[],"type":"text","url":"/docs/components/browser-session#properties","content":"| Name     | Type     | Description                                                                                 |\n| -------- | -------- | ------------------------------------------------------------------------------------------- |\n| `cursor` | `object` | The agent's own pointer, in pixels from the page's top left. Hidden while you have control. |","table":"table-0"},"52":{"id":"/docs/components/browser-session-10","page_id":"/docs/components/browser-session","tags":[],"type":"text","url":"/docs/components/browser-session#properties","content":"| Name  | Type     | Description                                                                            |\n| ----- | -------- | -------------------------------------------------------------------------------------- |\n| `ask` | `object` | While a step waits: the button that lets the agent go on. Has a `label` and `onAllow`. |","table":"table-0"},"53":{"id":"/docs/components/browser-session-11","page_id":"/docs/components/browser-session","tags":[],"type":"text","url":"/docs/components/browser-session#properties","content":"| Name                       | Type      | Description                                                                        |\n| -------------------------- | --------- | ---------------------------------------------------------------------------------- |\n| `paused` / `defaultPaused` | `boolean` | Pause holds the agent where it is. Leave `paused` out to let the button toggle it. |","table":"table-0"},"54":{"id":"/docs/components/browser-session-12","page_id":"/docs/components/browser-session","tags":[],"type":"text","url":"/docs/components/browser-session#properties","content":"| Name                             | Type      | Description                                                                         |\n| -------------------------------- | --------- | ----------------------------------------------------------------------------------- |\n| `inControl` / `defaultInControl` | `boolean` | Take over hands the page to you. Leave `inControl` out to let the button toggle it. |","table":"table-0"},"55":{"id":"/docs/components/browser-session-13","page_id":"/docs/components/browser-session","tags":[],"type":"text","url":"/docs/components/browser-session#properties","content":"| Name      | Type     | Description                                                                  |\n| --------- | -------- | ---------------------------------------------------------------------------- |\n| `seconds` | `number` | Seconds to show as m:ss. Leave it out to let the clock count while browsing. |","table":"table-0"},"56":{"id":"/docs/components/browser-session-14","page_id":"/docs/components/browser-session","tags":[],"type":"text","url":"/docs/components/browser-session#properties","content":"| Name     | Type     | Description                                                          |\n| -------- | -------- | -------------------------------------------------------------------- |\n| `status` | `string` | The line under the title. Defaults to a status word, then the clock. |","table":"table-0"},"57":{"id":"/docs/components/browser-session-15","page_id":"/docs/components/browser-session","tags":[],"type":"text","url":"/docs/components/browser-session#properties","content":"| Name      | Type     | Description                                    |\n| --------- | -------- | ---------------------------------------------- |\n| `summary` | `string` | Shown under the steps once every step is done. |","table":"table-0"},"58":{"id":"/docs/components/browser-session-16","page_id":"/docs/components/browser-session","tags":[],"type":"text","url":"/docs/components/browser-session#theming","content":"Works in light and dark (`data-theme=\"dark\"`) and in the Soft style (`data-style=\"soft\"`). The page\nis drawn small, with real words where they matter and grey lines for the rest; a price the agent has\ntaken is marked in the accent fill. While you have control the frame turns the accent colour. In\nBlueprint the frame and chips are squared off."},"59":{"id":"/docs/components/buttons","page_id":"/docs/components/buttons","type":"page","content":"Buttons","breadcrumbs":["Docs","Components","Forms and inputs"],"tags":[],"url":"/docs/components/buttons"},"60":{"id":"/docs/components/buttons-0","page_id":"/docs/components/buttons","tags":[],"type":"text","url":"/docs/components/buttons","content":"A pill button in the library's variants and sizes, with built-in busy, done and pressed states."},"61":{"id":"/docs/components/buttons-1","page_id":"/docs/components/buttons","type":"heading","tags":[],"url":"/docs/components/buttons#usage","content":"Usage"},"62":{"id":"/docs/components/buttons-2","page_id":"/docs/components/buttons","type":"heading","tags":[],"url":"/docs/components/buttons#properties","content":"Properties"},"63":{"id":"/docs/components/buttons-3","page_id":"/docs/components/buttons","type":"heading","tags":[],"url":"/docs/components/buttons#theming","content":"Theming"},"64":{"id":"/docs/components/buttons-4","page_id":"/docs/components/buttons","tags":[],"type":"text","url":"/docs/components/buttons","content":"A button is a pill in one of the variants — `primary` for the main action, `soft` and `line` for the\nrest, `ghost` for the quietest — in three sizes. Return a promise from `onClick` and the button runs\nitself: it shows the busy face until the promise settles, then the done face. `ButtonCopy` copies\ntext and flashes a check."},"65":{"id":"/docs/components/buttons-5","page_id":"/docs/components/buttons","tags":[],"type":"text","url":"/docs/components/buttons#properties","content":"| Name      | Type                                                | Description                                                             |\n| --------- | --------------------------------------------------- | ----------------------------------------------------------------------- |\n| `variant` | `primary \\| accent \\| soft \\| line \\| ghost \\| ink` | The style. Left out, a plain pill. `ink` is the old name for `primary`. |","table":"table-0"},"66":{"id":"/docs/components/buttons-6","page_id":"/docs/components/buttons","tags":[],"type":"text","url":"/docs/components/buttons#properties","content":"| Name   | Type             | Description                           |\n| ------ | ---------------- | ------------------------------------- |\n| `size` | `sm \\| md \\| lg` | The three sizes; `md` is the default. |","table":"table-0"},"67":{"id":"/docs/components/buttons-7","page_id":"/docs/components/buttons","tags":[],"type":"text","url":"/docs/components/buttons#properties","content":"| Name   | Type       | Description               |\n| ------ | ---------- | ------------------------- |\n| `icon` | `IconName` | An icon before the label. |","table":"table-0"},"68":{"id":"/docs/components/buttons-8","page_id":"/docs/components/buttons","tags":[],"type":"text","url":"/docs/components/buttons#properties","content":"| Name      | Type                              | Description                                                    |\n| --------- | --------------------------------- | -------------------------------------------------------------- |\n| `onClick` | `(e) => void \\| Promise<unknown>` | Return a promise and the button runs busy then done by itself. |","table":"table-0"},"69":{"id":"/docs/components/buttons-9","page_id":"/docs/components/buttons","tags":[],"type":"text","url":"/docs/components/buttons#properties","content":"| Name            | Type      | Description                                                           |\n| --------------- | --------- | --------------------------------------------------------------------- |\n| `busy` / `done` | `boolean` | Drive the busy or done face yourself. Clicks are ignored while shown. |","table":"table-0"},"70":{"id":"/docs/components/buttons-10","page_id":"/docs/components/buttons","tags":[],"type":"text","url":"/docs/components/buttons#properties","content":"| Name                      | Type        | Description                            |\n| ------------------------- | ----------- | -------------------------------------- |\n| `busyLabel` / `doneLabel` | `ReactNode` | The labels on the busy and done faces. |","table":"table-0"},"71":{"id":"/docs/components/buttons-11","page_id":"/docs/components/buttons","tags":[],"type":"text","url":"/docs/components/buttons#properties","content":"| Name        | Type            | Description                                             |\n| ----------- | --------------- | ------------------------------------------------------- |\n| `busyGlyph` | `spin \\| think` | The busy glyph: a spinner, or the agent's turning dots. |","table":"table-0"},"72":{"id":"/docs/components/buttons-12","page_id":"/docs/components/buttons","tags":[],"type":"text","url":"/docs/components/buttons#properties","content":"| Name      | Type      | Description                |\n| --------- | --------- | -------------------------- |\n| `success` | `boolean` | The done face turns green. |","table":"table-0"},"73":{"id":"/docs/components/buttons-13","page_id":"/docs/components/buttons","tags":[],"type":"text","url":"/docs/components/buttons#properties","content":"| Name      | Type      | Description                                        |\n| --------- | --------- | -------------------------------------------------- |\n| `pressed` | `boolean` | For a toggle: whether it is on, as `aria-pressed`. |","table":"table-0"},"74":{"id":"/docs/components/buttons-14","page_id":"/docs/components/buttons","tags":[],"type":"text","url":"/docs/components/buttons#properties","content":"| Name          | Type     | Description                                    |\n| ------------- | -------- | ---------------------------------------------- |\n| `tip` / `kbd` | `string` | A tooltip, with an optional shortcut after it. |","table":"table-0"},"75":{"id":"/docs/components/buttons-15","page_id":"/docs/components/buttons","tags":[],"type":"text","url":"/docs/components/buttons#theming","content":"Works in light and dark (`data-theme=\"dark\"`) and in the Soft style (`data-style=\"soft\"`). The\nvariants read against the theme's accent and surface tokens; in Soft the pills are rounder and\nsofter, and the busy and done faces blur across in either theme."},"76":{"id":"/docs/components/context-meter","page_id":"/docs/components/context-meter","type":"page","content":"Context meter","breadcrumbs":["Docs","Components","Agent status"],"tags":[],"url":"/docs/components/context-meter"},"77":{"id":"/docs/components/context-meter-0","page_id":"/docs/components/context-meter","tags":[],"type":"text","url":"/docs/components/context-meter","content":"How full the context is and what fills it, with a Compact action to free room."},"78":{"id":"/docs/components/context-meter-1","page_id":"/docs/components/context-meter","type":"heading","tags":[],"url":"/docs/components/context-meter#usage","content":"Usage"},"79":{"id":"/docs/components/context-meter-2","page_id":"/docs/components/context-meter","type":"heading","tags":[],"url":"/docs/components/context-meter#properties","content":"Properties"},"80":{"id":"/docs/components/context-meter-3","page_id":"/docs/components/context-meter","type":"heading","tags":[],"url":"/docs/components/context-meter#theming","content":"Theming"},"81":{"id":"/docs/components/context-meter-4","page_id":"/docs/components/context-meter","tags":[],"type":"text","url":"/docs/components/context-meter","content":"A context meter is a pill with a ring that shows how full the context window is. It opens a panel\nwith one bar split by kind, a legend whose rows list what is in each part, and a Compact button\nthat summarises older turns to free room. The ring turns orange past a warning share, and a message\nline fades in with a warning or a result."},"82":{"id":"/docs/components/context-meter-5","page_id":"/docs/components/context-meter","tags":[],"type":"text","url":"/docs/components/context-meter#properties","content":"| Name    | Type            | Description                                                                                                                  |\n| ------- | --------------- | ---------------------------------------------------------------------------------------------------------------------------- |\n| `parts` | `ContextPart[]` | What fills the context. Each has a `key`, a `label`, its `tokens`, an optional `color`, and optional `items` shown on hover. |","table":"table-0"},"83":{"id":"/docs/components/context-meter-6","page_id":"/docs/components/context-meter","tags":[],"type":"text","url":"/docs/components/context-meter#properties","content":"| Name    | Type     | Description                                             |\n| ------- | -------- | ------------------------------------------------------- |\n| `limit` | `number` | The size of the context window, in tokens, like 200000. |","table":"table-0"},"84":{"id":"/docs/components/context-meter-7","page_id":"/docs/components/context-meter","tags":[],"type":"text","url":"/docs/components/context-meter#properties","content":"| Name     | Type     | Description                                                                    |\n| -------- | -------- | ------------------------------------------------------------------------------ |\n| `warnAt` | `number` | From this share of the limit (0 to 1) the ring turns orange. Defaults to 0.85. |","table":"table-0"},"85":{"id":"/docs/components/context-meter-8","page_id":"/docs/components/context-meter","tags":[],"type":"text","url":"/docs/components/context-meter#properties","content":"| Name      | Type     | Description                                          |\n| --------- | -------- | ---------------------------------------------------- |\n| `message` | `string` | A line under the legend. Crossfades when it changes. |","table":"table-0"},"86":{"id":"/docs/components/context-meter-9","page_id":"/docs/components/context-meter","tags":[],"type":"text","url":"/docs/components/context-meter#properties","content":"| Name          | Type         | Description                                                            |\n| ------------- | ------------ | ---------------------------------------------------------------------- |\n| `messageTone` | `warn \\| ok` | warn shows it in orange with a warning sign, ok in green with a check. |","table":"table-0"},"87":{"id":"/docs/components/context-meter-10","page_id":"/docs/components/context-meter","tags":[],"type":"text","url":"/docs/components/context-meter#properties","content":"| Name        | Type      | Description                                     |\n| ----------- | --------- | ----------------------------------------------- |\n| `compacted` | `boolean` | Set once compacted: the button turns into Undo. |","table":"table-0"},"88":{"id":"/docs/components/context-meter-11","page_id":"/docs/components/context-meter","tags":[],"type":"text","url":"/docs/components/context-meter#properties","content":"| Name   | Type     | Description                                                             |\n| ------ | -------- | ----------------------------------------------------------------------- |\n| `hint` | `string` | The quiet line beside the button. Defaults to \"Summarises older turns\". |","table":"table-0"},"89":{"id":"/docs/components/context-meter-12","page_id":"/docs/components/context-meter","tags":[],"type":"text","url":"/docs/components/context-meter#properties","content":"| Name   | Type      | Description                                                        |\n| ------ | --------- | ------------------------------------------------------------------ |\n| `open` | `boolean` | Whether the panel is open. Leave it out to let the pill toggle it. |","table":"table-0"},"90":{"id":"/docs/components/context-meter-13","page_id":"/docs/components/context-meter","tags":[],"type":"text","url":"/docs/components/context-meter#properties","content":"| Name                    | Type       | Description                                                                |\n| ----------------------- | ---------- | -------------------------------------------------------------------------- |\n| `onCompact` / `compact` | `callback` | Called by Compact. Return a promise and the button spins until it settles. |","table":"table-0"},"91":{"id":"/docs/components/context-meter-14","page_id":"/docs/components/context-meter","tags":[],"type":"text","url":"/docs/components/context-meter#properties","content":"| Name              | Type       | Description                    |\n| ----------------- | ---------- | ------------------------------ |\n| `onUndo` / `undo` | `callback` | Called by Undo once compacted. |","table":"table-0"},"92":{"id":"/docs/components/context-meter-15","page_id":"/docs/components/context-meter","tags":[],"type":"text","url":"/docs/components/context-meter#properties","content":"| Name                          | Type       | Description                          |\n| ----------------------------- | ---------- | ------------------------------------ |\n| `onOpenChange` / `openChange` | `callback` | Fires when the panel opens or shuts. |","table":"table-0"},"93":{"id":"/docs/components/context-meter-16","page_id":"/docs/components/context-meter","tags":[],"type":"text","url":"/docs/components/context-meter#theming","content":"Works in light and dark (`data-theme=\"dark\"`) and in the Soft style (`data-style=\"soft\"`). In\nBlueprint the pill, the bar and the panel are squared off; in Soft they are rounded. The ring takes\nthe accent mark and the warning mark past the warning share, and the bar segments take the part\npalette (blue, teal, violet, grey) from the tokens unless a part sets its own color."},"94":{"id":"/docs/components/progress","page_id":"/docs/components/progress","type":"page","content":"Progress","breadcrumbs":["Docs","Components","Forms and inputs"],"tags":[],"url":"/docs/components/progress"},"95":{"id":"/docs/components/progress-0","page_id":"/docs/components/progress","tags":[],"type":"text","url":"/docs/components/progress","content":"A run's progress three ways — a ring for the whole run, segments for its steps and a bar for the step in hand — with controls and an optional meter that warns as it fills."},"96":{"id":"/docs/components/progress-1","page_id":"/docs/components/progress","type":"heading","tags":[],"url":"/docs/components/progress#usage","content":"Usage"},"97":{"id":"/docs/components/progress-2","page_id":"/docs/components/progress","type":"heading","tags":[],"url":"/docs/components/progress#properties","content":"Properties"},"98":{"id":"/docs/components/progress-3","page_id":"/docs/components/progress","type":"heading","tags":[],"url":"/docs/components/progress#theming","content":"Theming"},"99":{"id":"/docs/components/progress-4","page_id":"/docs/components/progress","tags":[],"type":"text","url":"/docs/components/progress","content":"Progress shows a long run three ways at once: a ring for the whole run, a segment per step, and a\nbar for how far the step in hand has got. The `state` colours it — grey while indeterminate or\npaused, the accent while running, red with a Retry on error, green when complete — and the controls\nfollow (Pause, Resume, Run again). An optional `meter` underneath warns in words as it fills."},"100":{"id":"/docs/components/progress-5","page_id":"/docs/components/progress","tags":[],"type":"text","url":"/docs/components/progress#properties","content":"| Name    | Type     | Description                               |\n| ------- | -------- | ----------------------------------------- |\n| `title` | `string` | The run's name, like \"Indexing the docs\". |","table":"table-0"},"101":{"id":"/docs/components/progress-6","page_id":"/docs/components/progress","tags":[],"type":"text","url":"/docs/components/progress#properties","content":"| Name    | Type                                                      | Description                                  |\n| ------- | --------------------------------------------------------- | -------------------------------------------- |\n| `state` | `indeterminate \\| running \\| paused \\| error \\| complete` | Colours the run and picks the control shown. |","table":"table-0"},"102":{"id":"/docs/components/progress-7","page_id":"/docs/components/progress","tags":[],"type":"text","url":"/docs/components/progress#properties","content":"| Name    | Type             | Description                               |\n| ------- | ---------------- | ----------------------------------------- |\n| `steps` | `ProgressStep[]` | The steps, each `{ label, unit, total }`. |","table":"table-0"},"103":{"id":"/docs/components/progress-8","page_id":"/docs/components/progress","tags":[],"type":"text","url":"/docs/components/progress#properties","content":"| Name   | Type     | Description                 |\n| ------ | -------- | --------------------------- |\n| `step` | `number` | The step in hand, from `0`. |","table":"table-0"},"104":{"id":"/docs/components/progress-9","page_id":"/docs/components/progress","tags":[],"type":"text","url":"/docs/components/progress#properties","content":"| Name           | Type     | Description                                   |\n| -------------- | -------- | --------------------------------------------- |\n| `stepProgress` | `number` | How far the step in hand has got, `0` to `1`. |","table":"table-0"},"105":{"id":"/docs/components/progress-10","page_id":"/docs/components/progress","tags":[],"type":"text","url":"/docs/components/progress#properties","content":"| Name        | Type     | Description                                             |\n| ----------- | -------- | ------------------------------------------------------- |\n| `valueText` | `string` | The line under the title. Defaults to \"Step 3 of 5, …\". |","table":"table-0"},"106":{"id":"/docs/components/progress-11","page_id":"/docs/components/progress","tags":[],"type":"text","url":"/docs/components/progress#properties","content":"| Name    | Type     | Description                                               |\n| ------- | -------- | --------------------------------------------------------- |\n| `error` | `string` | What failed, shown over the bar while `state` is `error`. |","table":"table-0"},"107":{"id":"/docs/components/progress-12","page_id":"/docs/components/progress","tags":[],"type":"text","url":"/docs/components/progress#properties","content":"| Name                                             | Type       | Description                                |\n| ------------------------------------------------ | ---------- | ------------------------------------------ |\n| `onPause` / `onResume` / `onRetry` / `onRestart` | `callback` | The controls, wired to the matching state. |","table":"table-0"},"108":{"id":"/docs/components/progress-13","page_id":"/docs/components/progress","tags":[],"type":"text","url":"/docs/components/progress#properties","content":"| Name    | Type            | Description                                                |\n| ------- | --------------- | ---------------------------------------------------------- |\n| `meter` | `ProgressMeter` | A meter under the run, with thresholds that warn in words. |","table":"table-0"},"109":{"id":"/docs/components/progress-14","page_id":"/docs/components/progress","tags":[],"type":"text","url":"/docs/components/progress#properties","content":"A `ProgressMeter` is `{ label, value, max, unit?, warnAt?, dangerAt?, dangerLabel?, note? }`: it\nreads \"On track\" until `value / max` crosses `warnAt` (\"Running low\") and then `dangerAt` (the\n`dangerLabel`, or \"Almost out\")."},"110":{"id":"/docs/components/progress-15","page_id":"/docs/components/progress","tags":[],"type":"text","url":"/docs/components/progress#theming","content":"Works in light and dark (`data-theme=\"dark\"`) and in the Soft style (`data-style=\"soft\"`). In\nBlueprint the ring, segments and bar are squared off with hairline tracks; in Soft they are rounded\nwith a softer fill. The state colours and the meter's warn and danger bands come from the theme, so\nthey read correctly on either background."},"111":{"id":"/docs/components/reasoning-trail","page_id":"/docs/components/reasoning-trail","type":"page","content":"Reasoning trail","breadcrumbs":["Docs","Components","Agent status"],"tags":[],"url":"/docs/components/reasoning-trail"},"112":{"id":"/docs/components/reasoning-trail-0","page_id":"/docs/components/reasoning-trail","tags":[],"type":"text","url":"/docs/components/reasoning-trail","content":"The agent's plan, notes, sources or edits, under a header it can fold away."},"113":{"id":"/docs/components/reasoning-trail-1","page_id":"/docs/components/reasoning-trail","type":"heading","tags":[],"url":"/docs/components/reasoning-trail#usage","content":"Usage"},"114":{"id":"/docs/components/reasoning-trail-2","page_id":"/docs/components/reasoning-trail","type":"heading","tags":[],"url":"/docs/components/reasoning-trail#properties","content":"Properties"},"115":{"id":"/docs/components/reasoning-trail-3","page_id":"/docs/components/reasoning-trail","type":"heading","tags":[],"url":"/docs/components/reasoning-trail#theming","content":"Theming"},"116":{"id":"/docs/components/reasoning-trail-4","page_id":"/docs/components/reasoning-trail","tags":[],"type":"text","url":"/docs/components/reasoning-trail","content":"A reasoning trail is the structured record the agent leaves after it thinks: a plan it works\nthrough, the notes it took, the sources it read, or the edits it made. Pick what it shows with\n`view`. The header counts the seconds and shimmers while the run is live, folds the trail away, and\nsettles on \"Reasoned for Ns\" once it finishes."},"117":{"id":"/docs/components/reasoning-trail-5","page_id":"/docs/components/reasoning-trail","tags":[],"type":"text","url":"/docs/components/reasoning-trail#properties","content":"| Name      | Type      | Description                                           |\n| --------- | --------- | ----------------------------------------------------- |\n| `running` | `boolean` | Shimmers the title and counts the seconds while true. |","table":"table-0"},"118":{"id":"/docs/components/reasoning-trail-6","page_id":"/docs/components/reasoning-trail","tags":[],"type":"text","url":"/docs/components/reasoning-trail#properties","content":"| Name      | Type     | Description                                                         |\n| --------- | -------- | ------------------------------------------------------------------- |\n| `seconds` | `number` | Seconds to show. Leave it out to let the trail count while it runs. |","table":"table-0"},"119":{"id":"/docs/components/reasoning-trail-7","page_id":"/docs/components/reasoning-trail","tags":[],"type":"text","url":"/docs/components/reasoning-trail#properties","content":"| Name    | Type     | Description                                                                     |\n| ------- | -------- | ------------------------------------------------------------------------------- |\n| `title` | `string` | Header text. Defaults to \"Reasoning\" while running and \"Reasoned for Ns\" after. |","table":"table-0"},"120":{"id":"/docs/components/reasoning-trail-8","page_id":"/docs/components/reasoning-trail","tags":[],"type":"text","url":"/docs/components/reasoning-trail#properties","content":"| Name   | Type         | Description                                                                                  |\n| ------ | ------------ | -------------------------------------------------------------------------------------------- |\n| `plan` | `PlanStep[]` | The plan. Each step has a `label`, an optional `detail`, and a `state` of done, now or next. |","table":"table-0"},"121":{"id":"/docs/components/reasoning-trail-9","page_id":"/docs/components/reasoning-trail","tags":[],"type":"text","url":"/docs/components/reasoning-trail#properties","content":"| Name    | Type       | Description                      |\n| ------- | ---------- | -------------------------------- |\n| `notes` | `string[]` | The agent's notes, one per line. |","table":"table-0"},"122":{"id":"/docs/components/reasoning-trail-10","page_id":"/docs/components/reasoning-trail","tags":[],"type":"text","url":"/docs/components/reasoning-trail#properties","content":"| Name      | Type       | Description                                                                                 |\n| --------- | ---------- | ------------------------------------------------------------------------------------------- |\n| `sources` | `Source[]` | The files and links it read. Each has a `label`, an optional `kind`, and an optional `tip`. |","table":"table-0"},"123":{"id":"/docs/components/reasoning-trail-11","page_id":"/docs/components/reasoning-trail","tags":[],"type":"text","url":"/docs/components/reasoning-trail#properties","content":"| Name    | Type     | Description                                                                                  |\n| ------- | -------- | -------------------------------------------------------------------------------------------- |\n| `edits` | `Edit[]` | The changed files. Each has a `file`, an optional `detail`, and `removed` and `added` lines. |","table":"table-0"},"124":{"id":"/docs/components/reasoning-trail-12","page_id":"/docs/components/reasoning-trail","tags":[],"type":"text","url":"/docs/components/reasoning-trail#properties","content":"| Name   | Type                                | Description                                                          |\n| ------ | ----------------------------------- | -------------------------------------------------------------------- |\n| `view` | `plan \\| notes \\| sources \\| edits` | Which part to show. Leave it out to start on the first one there is. |","table":"table-0"},"125":{"id":"/docs/components/reasoning-trail-13","page_id":"/docs/components/reasoning-trail","tags":[],"type":"text","url":"/docs/components/reasoning-trail#properties","content":"| Name   | Type      | Description                                                          |\n| ------ | --------- | -------------------------------------------------------------------- |\n| `open` | `boolean` | Whether the trail is open. Leave it out to let the header toggle it. |","table":"table-0"},"126":{"id":"/docs/components/reasoning-trail-14","page_id":"/docs/components/reasoning-trail","tags":[],"type":"text","url":"/docs/components/reasoning-trail#properties","content":"| Name   | Type      | Description                                                                       |\n| ------ | --------- | --------------------------------------------------------------------------------- |\n| `bare` | `boolean` | Sits flat in a chat thread (the default). Set false to give it a card of its own. |","table":"table-0"},"127":{"id":"/docs/components/reasoning-trail-15","page_id":"/docs/components/reasoning-trail","tags":[],"type":"text","url":"/docs/components/reasoning-trail#properties","content":"| Name                          | Type       | Description                        |\n| ----------------------------- | ---------- | ---------------------------------- |\n| `onViewChange` / `viewChange` | `callback` | Fires when the shown view changes. |","table":"table-0"},"128":{"id":"/docs/components/reasoning-trail-16","page_id":"/docs/components/reasoning-trail","tags":[],"type":"text","url":"/docs/components/reasoning-trail#properties","content":"| Name                          | Type       | Description                          |\n| ----------------------------- | ---------- | ------------------------------------ |\n| `onOpenChange` / `openChange` | `callback` | Fires when the trail opens or folds. |","table":"table-0"},"129":{"id":"/docs/components/reasoning-trail-17","page_id":"/docs/components/reasoning-trail","tags":[],"type":"text","url":"/docs/components/reasoning-trail#theming","content":"Works in light and dark (`data-theme=\"dark\"`) and in the Soft style (`data-style=\"soft\"`). In\nBlueprint the header, chips and edit blocks are squared off with hairline edges; in Soft they are\nrounded. The timeline rail, the pulse on the current step, and the shimmer on the title all take\ntheir colors from the tokens; added and removed lines use the add and remove colors."},"130":{"id":"/docs/components/run-cost","page_id":"/docs/components/run-cost","type":"page","content":"Run cost","breadcrumbs":["Docs","Components","Agent status"],"tags":[],"url":"/docs/components/run-cost"},"131":{"id":"/docs/components/run-cost-0","page_id":"/docs/components/run-cost","tags":[],"type":"text","url":"/docs/components/run-cost","content":"Live credit and token spend against a budget, with a cap the agent pauses at."},"132":{"id":"/docs/components/run-cost-1","page_id":"/docs/components/run-cost","type":"heading","tags":[],"url":"/docs/components/run-cost#usage","content":"Usage"},"133":{"id":"/docs/components/run-cost-2","page_id":"/docs/components/run-cost","type":"heading","tags":[],"url":"/docs/components/run-cost#properties","content":"Properties"},"134":{"id":"/docs/components/run-cost-3","page_id":"/docs/components/run-cost","type":"heading","tags":[],"url":"/docs/components/run-cost#theming","content":"Theming"},"135":{"id":"/docs/components/run-cost-4","page_id":"/docs/components/run-cost","tags":[],"type":"text","url":"/docs/components/run-cost","content":"A run cost shows the credits a run has used against its budget, as a number and a meter. A cap\nmarks where the agent pauses, drawn as a line across the bar; when the spend reaches it the status\nturns amber and the run pauses. The breakdown under the bar shows the tokens and tool calls behind\nthe number, and the button starts, stops, resumes or raises the cap by status."},"136":{"id":"/docs/components/run-cost-5","page_id":"/docs/components/run-cost","tags":[],"type":"text","url":"/docs/components/run-cost#properties","content":"| Name   | Type     | Description          |\n| ------ | -------- | -------------------- |\n| `used` | `number` | Credits used so far. |","table":"table-0"},"137":{"id":"/docs/components/run-cost-6","page_id":"/docs/components/run-cost","tags":[],"type":"text","url":"/docs/components/run-cost#properties","content":"| Name     | Type     | Description                  |\n| -------- | -------- | ---------------------------- |\n| `budget` | `number` | The whole budget, like 2000. |","table":"table-0"},"138":{"id":"/docs/components/run-cost-7","page_id":"/docs/components/run-cost","tags":[],"type":"text","url":"/docs/components/run-cost#properties","content":"| Name    | Type     | Description                                                            |\n| ------- | -------- | ---------------------------------------------------------------------- |\n| `capAt` | `number` | Where the agent pauses, as a percentage of the budget. Defaults to 90. |","table":"table-0"},"139":{"id":"/docs/components/run-cost-8","page_id":"/docs/components/run-cost","tags":[],"type":"text","url":"/docs/components/run-cost#properties","content":"| Name    | Type      | Description                                                      |\n| ------- | --------- | ---------------------------------------------------------------- |\n| `capOn` | `boolean` | Whether the cap is on. Leave it out to let the switch change it. |","table":"table-0"},"140":{"id":"/docs/components/run-cost-9","page_id":"/docs/components/run-cost","tags":[],"type":"text","url":"/docs/components/run-cost#properties","content":"| Name     | Type                                            | Description                               |\n| -------- | ----------------------------------------------- | ----------------------------------------- |\n| `status` | `idle \\| running \\| stopped \\| paused \\| spent` | running is blue, paused amber, spent red. |","table":"table-0"},"141":{"id":"/docs/components/run-cost-10","page_id":"/docs/components/run-cost","tags":[],"type":"text","url":"/docs/components/run-cost#properties","content":"| Name          | Type     | Description                                  |\n| ------------- | -------- | -------------------------------------------- |\n| `statusLabel` | `string` | Words in the status tag. Defaults by status. |","table":"table-0"},"142":{"id":"/docs/components/run-cost-11","page_id":"/docs/components/run-cost","tags":[],"type":"text","url":"/docs/components/run-cost#properties","content":"| Name   | Type           | Description                                                        |\n| ------ | -------------- | ------------------------------------------------------------------ |\n| `rows` | `RunCostRow[]` | The breakdown under the bar; each row has a `label` and a `value`. |","table":"table-0"},"143":{"id":"/docs/components/run-cost-12","page_id":"/docs/components/run-cost","tags":[],"type":"text","url":"/docs/components/run-cost#properties","content":"| Name          | Type     | Description                              |\n| ------------- | -------- | ---------------------------------------- |\n| `actionLabel` | `string` | Words on the button. Defaults by status. |","table":"table-0"},"144":{"id":"/docs/components/run-cost-13","page_id":"/docs/components/run-cost","tags":[],"type":"text","url":"/docs/components/run-cost#properties","content":"| Name    | Type     | Description                 |\n| ------- | -------- | --------------------------- |\n| `title` | `string` | Defaults to \"Credits used\". |","table":"table-0"},"145":{"id":"/docs/components/run-cost-14","page_id":"/docs/components/run-cost","tags":[],"type":"text","url":"/docs/components/run-cost#properties","content":"| Name   | Type      | Description                                                                       |\n| ------ | --------- | --------------------------------------------------------------------------------- |\n| `bare` | `boolean` | Sits flat in a chat thread (the default). Set false to give it a card of its own. |","table":"table-0"},"146":{"id":"/docs/components/run-cost-15","page_id":"/docs/components/run-cost","tags":[],"type":"text","url":"/docs/components/run-cost#properties","content":"| Name                  | Type       | Description           |\n| --------------------- | ---------- | --------------------- |\n| `onAction` / `action` | `callback` | Called by the button. |","table":"table-0"},"147":{"id":"/docs/components/run-cost-16","page_id":"/docs/components/run-cost","tags":[],"type":"text","url":"/docs/components/run-cost#properties","content":"| Name                        | Type       | Description                        |\n| --------------------------- | ---------- | ---------------------------------- |\n| `onCapChange` / `capChange` | `callback` | Fires when the cap switch changes. |","table":"table-0"},"148":{"id":"/docs/components/run-cost-17","page_id":"/docs/components/run-cost","tags":[],"type":"text","url":"/docs/components/run-cost#theming","content":"Works in light and dark (`data-theme=\"dark\"`) and in the Soft style (`data-style=\"soft\"`). In\nBlueprint the bar, the tag and the toggle are squared off; in Soft they are rounded. The fill takes\nthe accent mark while running and the warning mark once paused at the cap, and the status tag tints\nto match its state, all from the tokens."},"149":{"id":"/docs/components/run-queue","page_id":"/docs/components/run-queue","type":"page","content":"Run queue","breadcrumbs":["Docs","Components","Agent status"],"tags":[],"url":"/docs/components/run-queue"},"150":{"id":"/docs/components/run-queue-0","page_id":"/docs/components/run-queue","tags":[],"type":"text","url":"/docs/components/run-queue","content":"A queue of agent jobs in three parts — the one running with its steps and progress, the ones up next, and the ones done — with a compact toggle."},"151":{"id":"/docs/components/run-queue-1","page_id":"/docs/components/run-queue","type":"heading","tags":[],"url":"/docs/components/run-queue#usage","content":"Usage"},"152":{"id":"/docs/components/run-queue-2","page_id":"/docs/components/run-queue","type":"heading","tags":[],"url":"/docs/components/run-queue#properties","content":"Properties"},"153":{"id":"/docs/components/run-queue-3","page_id":"/docs/components/run-queue","type":"heading","tags":[],"url":"/docs/components/run-queue#theming","content":"Theming"},"154":{"id":"/docs/components/run-queue-4","page_id":"/docs/components/run-queue","tags":[],"type":"text","url":"/docs/components/run-queue","content":"A run queue shows a batch of agent jobs moving through three parts. The job running is raised on\nits own card with its agent, its steps, a progress bar and the time left. The jobs up next wait\nbelow, each with when it should start, and the jobs done sit under them with how long each took and\na green tick. A failed step turns its job red and offers a Retry; a Detailed / Compact switch folds\nthe running job's steps away; and once every job is done a summary takes the running job's place."},"155":{"id":"/docs/components/run-queue-5","page_id":"/docs/components/run-queue","tags":[],"type":"text","url":"/docs/components/run-queue#properties","content":"| Name   | Type       | Description                                                                                                               |\n| ------ | ---------- | ------------------------------------------------------------------------------------------------------------------------- |\n| `jobs` | `RunJob[]` | The jobs in the queue. Each has a title, an agent, an icon, a state, an optional progress, a time, a note, and its steps. |","table":"table-0"},"156":{"id":"/docs/components/run-queue-6","page_id":"/docs/components/run-queue","tags":[],"type":"text","url":"/docs/components/run-queue#properties","content":"| Name    | Type     | Description                            |\n| ------- | -------- | -------------------------------------- |\n| `title` | `string` | The queue's name over its status line. |","table":"table-0"},"157":{"id":"/docs/components/run-queue-7","page_id":"/docs/components/run-queue","tags":[],"type":"text","url":"/docs/components/run-queue#properties","content":"| Name     | Type     | Description                                                           |\n| -------- | -------- | --------------------------------------------------------------------- |\n| `status` | `string` | Overrides the status line. Defaults to \"1 of 4 done\" or \"All 4 done\". |","table":"table-0"},"158":{"id":"/docs/components/run-queue-8","page_id":"/docs/components/run-queue","tags":[],"type":"text","url":"/docs/components/run-queue#properties","content":"| Name      | Type     | Description                                                                             |\n| --------- | -------- | --------------------------------------------------------------------------------------- |\n| `summary` | `string` | The line under \"All N jobs done\" once every job is done, like \"18.4s in all · 1 retry\". |","table":"table-0"},"159":{"id":"/docs/components/run-queue-9","page_id":"/docs/components/run-queue","tags":[],"type":"text","url":"/docs/components/run-queue#properties","content":"| Name      | Type                  | Description                                                                                       |\n| --------- | --------------------- | ------------------------------------------------------------------------------------------------- |\n| `density` | `detailed \\| compact` | detailed lists the running job's steps, compact folds them away. Left out, the switch changes it. |","table":"table-0"},"160":{"id":"/docs/components/run-queue-10","page_id":"/docs/components/run-queue","tags":[],"type":"text","url":"/docs/components/run-queue#properties","content":"| Name                                | Type       | Description                                       |\n| ----------------------------------- | ---------- | ------------------------------------------------- |\n| `onDensityChange` / `densityChange` | `callback` | Fires when the Detailed / Compact switch changes. |","table":"table-0"},"161":{"id":"/docs/components/run-queue-11","page_id":"/docs/components/run-queue","tags":[],"type":"text","url":"/docs/components/run-queue#properties","content":"| Name                | Type       | Description                                                                                                          |\n| ------------------- | ---------- | -------------------------------------------------------------------------------------------------------------------- |\n| `onRetry` / `retry` | `callback` | Called by a failed step's Retry button with the job's and the step's index. Without it, failed steps show no button. |","table":"table-0"},"162":{"id":"/docs/components/run-queue-12","page_id":"/docs/components/run-queue","tags":[],"type":"text","url":"/docs/components/run-queue#properties","content":"| Name   | Type      | Description                                                 |\n| ------ | --------- | ----------------------------------------------------------- |\n| `bare` | `boolean` | Sits flat in a chat thread, with no card. False by default. |","table":"table-0"},"163":{"id":"/docs/components/run-queue-13","page_id":"/docs/components/run-queue","tags":[],"type":"text","url":"/docs/components/run-queue#properties","content":"A `RunJob` state is queued, running, failed, or done. A `RunStep` has a label, a state, and an\noptional meta shown once the step is done. Progress defaults to the share of a job's steps that are\ndone."},"164":{"id":"/docs/components/run-queue-14","page_id":"/docs/components/run-queue","tags":[],"type":"text","url":"/docs/components/run-queue#theming","content":"Works in light and dark (`data-theme=\"dark\"`) and in the Soft style (`data-style=\"soft\"`). In\nBlueprint the running job gets a hairline in the accent and the progress bars fill in steps. A\nfailed job turns red with a hatched fill; the step glyphs are a spinner while running, a tick when\ndone, and a cross on failure."},"165":{"id":"/docs/components/segmented-control","page_id":"/docs/components/segmented-control","type":"page","content":"Segmented Control","breadcrumbs":["Docs","Components","Dates"],"tags":[],"url":"/docs/components/segmented-control"},"166":{"id":"/docs/components/segmented-control-0","page_id":"/docs/components/segmented-control","tags":[],"type":"text","url":"/docs/components/segmented-control","content":"One choice from a few views or options, with a white knob that slides to the picked one. Works as tabs or as a radio group, fully keyboard driven."},"167":{"id":"/docs/components/segmented-control-1","page_id":"/docs/components/segmented-control","type":"heading","tags":[],"url":"/docs/components/segmented-control#usage","content":"Usage"},"168":{"id":"/docs/components/segmented-control-2","page_id":"/docs/components/segmented-control","type":"heading","tags":[],"url":"/docs/components/segmented-control#properties","content":"Properties"},"169":{"id":"/docs/components/segmented-control-3","page_id":"/docs/components/segmented-control","type":"heading","tags":[],"url":"/docs/components/segmented-control#theming","content":"Theming"},"170":{"id":"/docs/components/segmented-control-4","page_id":"/docs/components/segmented-control","tags":[],"type":"text","url":"/docs/components/segmented-control","content":"A segmented control picks one of a few options. A white knob slides to the picked one. As `tabs`\n(the default) it switches a panel; as a `radio` group it sets an option. The arrow keys move along\nand pick, and Home and End jump to the ends. The `label` is required and names the group for screen\nreaders."},"171":{"id":"/docs/components/segmented-control-5","page_id":"/docs/components/segmented-control","tags":[],"type":"text","url":"/docs/components/segmented-control#properties","content":"| Name      | Type                                    | Description                           |\n| --------- | --------------------------------------- | ------------------------------------- |\n| `options` | `{ value: string; label: ReactNode }[]` | The choices, in order, left to right. |","table":"table-0"},"172":{"id":"/docs/components/segmented-control-6","page_id":"/docs/components/segmented-control","tags":[],"type":"text","url":"/docs/components/segmented-control#properties","content":"| Name                     | Type     | Description                                                                   |\n| ------------------------ | -------- | ----------------------------------------------------------------------------- |\n| `value` / `defaultValue` | `string` | The picked value. Pass `value` with `onValueChange` for a controlled control. |","table":"table-0"},"173":{"id":"/docs/components/segmented-control-7","page_id":"/docs/components/segmented-control","tags":[],"type":"text","url":"/docs/components/segmented-control#properties","content":"| Name            | Type                      | Description                                     |\n| --------------- | ------------------------- | ----------------------------------------------- |\n| `onValueChange` | `(value: string) => void` | Fires with the new value when the pick changes. |","table":"table-0"},"174":{"id":"/docs/components/segmented-control-8","page_id":"/docs/components/segmented-control","tags":[],"type":"text","url":"/docs/components/segmented-control#properties","content":"| Name    | Type     | Description                                                |\n| ------- | -------- | ---------------------------------------------------------- |\n| `label` | `string` | Names the group for screen readers, like `View`. Required. |","table":"table-0"},"175":{"id":"/docs/components/segmented-control-9","page_id":"/docs/components/segmented-control","tags":[],"type":"text","url":"/docs/components/segmented-control#properties","content":"| Name | Type            | Description                                                                    |\n| ---- | --------------- | ------------------------------------------------------------------------------ |\n| `as` | `tabs \\| radio` | `tabs` (the default) when it switches a panel, `radio` when it sets an option. |","table":"table-0"},"176":{"id":"/docs/components/segmented-control-10","page_id":"/docs/components/segmented-control","tags":[],"type":"text","url":"/docs/components/segmented-control#properties","content":"| Name | Type     | Description                                                                                                                                        |\n| ---- | -------- | -------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `id` | `string` | Ties the tabs to their panel: give the panel an id of the form \"id-panel\" and point its aria-labelledby at \"id-value\". Defaults to a generated id. |","table":"table-0"},"177":{"id":"/docs/components/segmented-control-11","page_id":"/docs/components/segmented-control","tags":[],"type":"text","url":"/docs/components/segmented-control#theming","content":"Works in light and dark (`data-theme=\"dark\"`) and in the Soft style (`data-style=\"soft\"`). The\ntrack and sliding knob take the active theme's surface and accent colors; in Blueprint the control\nis squared off, in Soft it is a pill with a rounder knob."},"178":{"id":"/docs/components/stat-cards","page_id":"/docs/components/stat-cards","type":"page","content":"Stat cards","breadcrumbs":["Docs","Components","Charts and tables"],"tags":[],"url":"/docs/components/stat-cards"},"179":{"id":"/docs/components/stat-cards-0","page_id":"/docs/components/stat-cards","tags":[],"type":"text","url":"/docs/components/stat-cards","content":"A row of KPIs, each with its change against the period before and a sparkline, with a period switch that rolls the numbers and redraws the lines."},"180":{"id":"/docs/components/stat-cards-1","page_id":"/docs/components/stat-cards","type":"heading","tags":[],"url":"/docs/components/stat-cards#usage","content":"Usage"},"181":{"id":"/docs/components/stat-cards-2","page_id":"/docs/components/stat-cards","type":"heading","tags":[],"url":"/docs/components/stat-cards#properties","content":"Properties"},"182":{"id":"/docs/components/stat-cards-3","page_id":"/docs/components/stat-cards","type":"heading","tags":[],"url":"/docs/components/stat-cards#theming","content":"Theming"},"183":{"id":"/docs/components/stat-cards-4","page_id":"/docs/components/stat-cards","tags":[],"type":"text","url":"/docs/components/stat-cards","content":"Stat cards are a row of numbers that matter. Each card has an icon, a label, the value in large\ntype, its change against the period before (green from zero, red below), and a sparkline in its own\ncolour. A `period` switch along the top rolls the numbers to their new values and redraws every\nline."},"184":{"id":"/docs/components/stat-cards-5","page_id":"/docs/components/stat-cards","tags":[],"type":"text","url":"/docs/components/stat-cards#properties","content":"| Name    | Type              | Description                                                                                                         |\n| ------- | ----------------- | ------------------------------------------------------------------------------------------------------------------- |\n| `stats` | `StatCardsStat[]` | The cards. Each has an `icon`, `label`, one `values` entry per period, and optional `prefix`, `suffix` and `color`. |","table":"table-0"},"185":{"id":"/docs/components/stat-cards-6","page_id":"/docs/components/stat-cards","tags":[],"type":"text","url":"/docs/components/stat-cards#properties","content":"| Name      | Type                | Description                                                                           |\n| --------- | ------------------- | ------------------------------------------------------------------------------------- |\n| `periods` | `StatCardsPeriod[]` | The switch options. Each has a `label` and an optional `compare` line shown on hover. |","table":"table-0"},"186":{"id":"/docs/components/stat-cards-7","page_id":"/docs/components/stat-cards","tags":[],"type":"text","url":"/docs/components/stat-cards#properties","content":"| Name     | Type     | Description                                                           |\n| -------- | -------- | --------------------------------------------------------------------- |\n| `period` | `number` | The period on show, by index. Leave it out to let the switch pick it. |","table":"table-0"},"187":{"id":"/docs/components/stat-cards-8","page_id":"/docs/components/stat-cards","tags":[],"type":"text","url":"/docs/components/stat-cards#properties","content":"| Name            | Type     | Description                                                |\n| --------------- | -------- | ---------------------------------------------------------- |\n| `defaultPeriod` | `number` | The period shown first when uncontrolled. Defaults to `0`. |","table":"table-0"},"188":{"id":"/docs/components/stat-cards-9","page_id":"/docs/components/stat-cards","tags":[],"type":"text","url":"/docs/components/stat-cards#properties","content":"| Name             | Type                       | Description                                        |\n| ---------------- | -------------------------- | -------------------------------------------------- |\n| `onPeriodChange` | `(period: number) => void` | Called with the new index when the switch changes. |","table":"table-0"},"189":{"id":"/docs/components/stat-cards-10","page_id":"/docs/components/stat-cards","tags":[],"type":"text","url":"/docs/components/stat-cards#properties","content":"| Name         | Type               | Description                                                               |\n| ------------ | ------------------ | ------------------------------------------------------------------------- |\n| `sparkRange` | `[number, number]` | The bottom and top of every sparkline. Defaults to each card's own range. |","table":"table-0"},"190":{"id":"/docs/components/stat-cards-11","page_id":"/docs/components/stat-cards","tags":[],"type":"text","url":"/docs/components/stat-cards#properties","content":"Each `StatCardsStat` carries `values: { value, change, points }[]` — one entry per period, in the\nsame order as `periods` — where `value` is the number, `change` is the percent against the period\nbefore, and `points` is the sparkline oldest first."},"191":{"id":"/docs/components/stat-cards-12","page_id":"/docs/components/stat-cards","tags":[],"type":"text","url":"/docs/components/stat-cards#theming","content":"Works in light and dark (`data-theme=\"dark\"`) and in the Soft style (`data-style=\"soft\"`). In\nBlueprint the cards are squared off with hairline borders; in Soft they are rounded panels with a\nsofter shadow. The sparkline colours fall back to the chart palette (the accent, then violet, green\nand orange) unless a card sets its own `color`."},"192":{"id":"/docs/components/status-pill","page_id":"/docs/components/status-pill","type":"page","content":"Status pill","breadcrumbs":["Docs","Components","Agent status"],"tags":[],"url":"/docs/components/status-pill"},"193":{"id":"/docs/components/status-pill-0","page_id":"/docs/components/status-pill","tags":[],"type":"text","url":"/docs/components/status-pill","content":"One live line for what an agent is doing right now, fading between its states and resizing to fit them."},"194":{"id":"/docs/components/status-pill-1","page_id":"/docs/components/status-pill","type":"heading","tags":[],"url":"/docs/components/status-pill#usage","content":"Usage"},"195":{"id":"/docs/components/status-pill-2","page_id":"/docs/components/status-pill","type":"heading","tags":[],"url":"/docs/components/status-pill#properties","content":"Properties"},"196":{"id":"/docs/components/status-pill-3","page_id":"/docs/components/status-pill","type":"heading","tags":[],"url":"/docs/components/status-pill#theming","content":"Theming"},"197":{"id":"/docs/components/status-pill-4","page_id":"/docs/components/status-pill","tags":[],"type":"text","url":"/docs/components/status-pill","content":"A status pill shows a single line of what the agent is up to. Its `state` picks the glyph and\ncolour — `thinking`, `reading` and `working` shimmer while they run — and a new `state`, `label`,\n`file` or `action` fades the old line out before the new one arrives. The `bar` variant is taller\nand draws a `progress` track along its bottom."},"198":{"id":"/docs/components/status-pill-5","page_id":"/docs/components/status-pill","tags":[],"type":"text","url":"/docs/components/status-pill#properties","content":"| Name    | Type     | Description                                        |\n| ------- | -------- | -------------------------------------------------- |\n| `label` | `string` | What the agent is doing, in a few words. Required. |","table":"table-0"},"199":{"id":"/docs/components/status-pill-6","page_id":"/docs/components/status-pill","tags":[],"type":"text","url":"/docs/components/status-pill#properties","content":"| Name    | Type                                                        | Description                                                                             |\n| ------- | ----------------------------------------------------------- | --------------------------------------------------------------------------------------- |\n| `state` | `idle \\| thinking \\| reading \\| working \\| waiting \\| done` | Picks the glyph and colour. `thinking`, `reading` and `working` shimmer while they run. |","table":"table-0"},"200":{"id":"/docs/components/status-pill-7","page_id":"/docs/components/status-pill","tags":[],"type":"text","url":"/docs/components/status-pill#properties","content":"| Name   | Type     | Description                                                                                |\n| ------ | -------- | ------------------------------------------------------------------------------------------ |\n| `meta` | `string` | Quiet detail after the label, like \"2 of 4\". Changing only this does not restart the pill. |","table":"table-0"},"201":{"id":"/docs/components/status-pill-8","page_id":"/docs/components/status-pill","tags":[],"type":"text","url":"/docs/components/status-pill#properties","content":"| Name   | Type                              | Description                  |\n| ------ | --------------------------------- | ---------------------------- |\n| `file` | `{ name: string; type?: string }` | A file chip after the label. |","table":"table-0"},"202":{"id":"/docs/components/status-pill-9","page_id":"/docs/components/status-pill","tags":[],"type":"text","url":"/docs/components/status-pill#properties","content":"| Name     | Type                                     | Description                                               |\n| -------- | ---------------------------------------- | --------------------------------------------------------- |\n| `action` | `{ label: string; onClick: () => void }` | A button at the end, for when the agent needs the person. |","table":"table-0"},"203":{"id":"/docs/components/status-pill-10","page_id":"/docs/components/status-pill","tags":[],"type":"text","url":"/docs/components/status-pill#properties","content":"| Name       | Type     | Description                                                       |\n| ---------- | -------- | ----------------------------------------------------------------- |\n| `progress` | `number` | 0 to 100, drawn as a track along the bottom of the `bar` variant. |","table":"table-0"},"204":{"id":"/docs/components/status-pill-11","page_id":"/docs/components/status-pill","tags":[],"type":"text","url":"/docs/components/status-pill#properties","content":"| Name      | Type          | Description                                                                      |\n| --------- | ------------- | -------------------------------------------------------------------------------- |\n| `variant` | `pill \\| bar` | `pill` hugs its content; `bar` is taller and leaves room for the progress track. |","table":"table-0"},"205":{"id":"/docs/components/status-pill-12","page_id":"/docs/components/status-pill","tags":[],"type":"text","url":"/docs/components/status-pill#theming","content":"Works in light and dark (`data-theme=\"dark\"`) and in the Soft style (`data-style=\"soft\"`). The pill\nsits on a surface with the shared shadow, so it picks up the theme's surface and token colours; in\nSoft it is rounder, and in dark it reads against the dark stage."},"206":{"id":"/docs/components/step-loader","page_id":"/docs/components/step-loader","type":"page","content":"Step Loader","breadcrumbs":["Docs","Components","Agent status"],"tags":[],"url":"/docs/components/step-loader"},"207":{"id":"/docs/components/step-loader-0","page_id":"/docs/components/step-loader","tags":[],"type":"text","url":"/docs/components/step-loader","content":"A named-steps progress list with a loader beside the running step, a track that fills as steps finish, and an expandable list of every step."},"208":{"id":"/docs/components/step-loader-1","page_id":"/docs/components/step-loader","type":"heading","tags":[],"url":"/docs/components/step-loader#usage","content":"Usage"},"209":{"id":"/docs/components/step-loader-2","page_id":"/docs/components/step-loader","type":"heading","tags":[],"url":"/docs/components/step-loader#properties","content":"Properties"},"210":{"id":"/docs/components/step-loader-3","page_id":"/docs/components/step-loader","type":"heading","tags":[],"url":"/docs/components/step-loader#theming","content":"Theming"},"211":{"id":"/docs/components/step-loader-4","page_id":"/docs/components/step-loader","tags":[],"type":"text","url":"/docs/components/step-loader","content":"A step loader shows an agent's work as named steps. The step running now sits beside a small\nloader; a track below fills as steps finish; and the row expands to the full list, each line\nswitching to its `done` text once complete. When `current` reaches the number of steps, every step\nis done and the row shows the `doneLabel`."},"212":{"id":"/docs/components/step-loader-5","page_id":"/docs/components/step-loader","tags":[],"type":"text","url":"/docs/components/step-loader#properties","content":"| Name    | Type                                 | Description                                                                           |\n| ------- | ------------------------------------ | ------------------------------------------------------------------------------------- |\n| `steps` | `{ label: string; done?: string }[]` | The steps. `label` shows while running, `done` once finished (falls back to `label`). |","table":"table-0"},"213":{"id":"/docs/components/step-loader-6","page_id":"/docs/components/step-loader","tags":[],"type":"text","url":"/docs/components/step-loader#properties","content":"| Name      | Type     | Description                                                                     |\n| --------- | -------- | ------------------------------------------------------------------------------- |\n| `current` | `number` | Index of the step running now. `steps.length` or more means every step is done. |","table":"table-0"},"214":{"id":"/docs/components/step-loader-7","page_id":"/docs/components/step-loader","tags":[],"type":"text","url":"/docs/components/step-loader#properties","content":"| Name     | Type                            | Description                                                   |\n| -------- | ------------------------------- | ------------------------------------------------------------- |\n| `loader` | `radar \\| dots \\| ring \\| bars` | The loader glyph beside the running step. `radar` by default. |","table":"table-0"},"215":{"id":"/docs/components/step-loader-8","page_id":"/docs/components/step-loader","tags":[],"type":"text","url":"/docs/components/step-loader#properties","content":"| Name        | Type     | Description                                                   |\n| ----------- | -------- | ------------------------------------------------------------- |\n| `doneLabel` | `string` | Label once every step is done. `Ready for review` by default. |","table":"table-0"},"216":{"id":"/docs/components/step-loader-9","page_id":"/docs/components/step-loader","tags":[],"type":"text","url":"/docs/components/step-loader#properties","content":"| Name                   | Type      | Description                                                               |\n| ---------------------- | --------- | ------------------------------------------------------------------------- |\n| `open` / `defaultOpen` | `boolean` | Whether the full list is open. Leave `open` out to let the row toggle it. |","table":"table-0"},"217":{"id":"/docs/components/step-loader-10","page_id":"/docs/components/step-loader","tags":[],"type":"text","url":"/docs/components/step-loader#properties","content":"| Name           | Type       | Description                                  |\n| -------------- | ---------- | -------------------------------------------- |\n| `onOpenChange` | `callback` | Fires when the row opens or closes the list. |","table":"table-0"},"218":{"id":"/docs/components/step-loader-11","page_id":"/docs/components/step-loader","tags":[],"type":"text","url":"/docs/components/step-loader#theming","content":"Works in light and dark (`data-theme=\"dark\"`) and in the Soft style (`data-style=\"soft\"`). The\ntrack and loader take the accent color from the active theme; in Soft the row and track are softer\nand more rounded than in Blueprint."},"219":{"id":"/docs/components/thinking-states","page_id":"/docs/components/thinking-states","type":"page","content":"Thinking States","breadcrumbs":["Docs","Components","Agent status"],"tags":[],"url":"/docs/components/thinking-states"},"220":{"id":"/docs/components/thinking-states-0","page_id":"/docs/components/thinking-states","tags":[],"type":"text","url":"/docs/components/thinking-states","content":"Six animated indicators, each a small mark beside a status line that steps through what an agent is doing, with an optional elapsed-seconds counter."},"221":{"id":"/docs/components/thinking-states-1","page_id":"/docs/components/thinking-states","type":"heading","tags":[],"url":"/docs/components/thinking-states#usage","content":"Usage"},"222":{"id":"/docs/components/thinking-states-2","page_id":"/docs/components/thinking-states","type":"heading","tags":[],"url":"/docs/components/thinking-states#properties","content":"Properties"},"223":{"id":"/docs/components/thinking-states-3","page_id":"/docs/components/thinking-states","type":"heading","tags":[],"url":"/docs/components/thinking-states#theming","content":"Theming"},"224":{"id":"/docs/components/thinking-states-4","page_id":"/docs/components/thinking-states","tags":[],"type":"text","url":"/docs/components/thinking-states","content":"A thinking state is a small animated mark beside a status line. Pick one of six marks with\n`variant`; give it `steps` and, with more than one, they take turns every `interval` unless you\ndrive the index with `current`. An elapsed-seconds counter sits at the end of the line and counts\nby itself unless you set `seconds` or hide it with `seconds={false}`."},"225":{"id":"/docs/components/thinking-states-5","page_id":"/docs/components/thinking-states","tags":[],"type":"text","url":"/docs/components/thinking-states#properties","content":"| Name      | Type                                                  | Description                                  |\n| --------- | ----------------------------------------------------- | -------------------------------------------- |\n| `variant` | `orbit \\| morph \\| scan \\| stream \\| matrix \\| stack` | Which indicator to draw. `orbit` by default. |","table":"table-0"},"226":{"id":"/docs/components/thinking-states-6","page_id":"/docs/components/thinking-states","tags":[],"type":"text","url":"/docs/components/thinking-states#properties","content":"| Name    | Type       | Description                                                                   |\n| ------- | ---------- | ----------------------------------------------------------------------------- |\n| `steps` | `string[]` | The status lines. With more than one they take turns unless `current` is set. |","table":"table-0"},"227":{"id":"/docs/components/thinking-states-7","page_id":"/docs/components/thinking-states","tags":[],"type":"text","url":"/docs/components/thinking-states#properties","content":"| Name      | Type     | Description                                                                        |\n| --------- | -------- | ---------------------------------------------------------------------------------- |\n| `current` | `number` | Index of the line to show. Leave it out to let the lines take turns by themselves. |","table":"table-0"},"228":{"id":"/docs/components/thinking-states-8","page_id":"/docs/components/thinking-states","tags":[],"type":"text","url":"/docs/components/thinking-states#properties","content":"| Name       | Type     | Description                                                               |\n| ---------- | -------- | ------------------------------------------------------------------------- |\n| `interval` | `number` | Milliseconds each line shows for when they take turns. `2600` by default. |","table":"table-0"},"229":{"id":"/docs/components/thinking-states-9","page_id":"/docs/components/thinking-states","tags":[],"type":"text","url":"/docs/components/thinking-states#properties","content":"| Name      | Type              | Description                                                                             |\n| --------- | ----------------- | --------------------------------------------------------------------------------------- |\n| `seconds` | `number \\| false` | Seconds shown at the end of the line. Counts by itself when left out; `false` hides it. |","table":"table-0"},"230":{"id":"/docs/components/thinking-states-10","page_id":"/docs/components/thinking-states","tags":[],"type":"text","url":"/docs/components/thinking-states#theming","content":"Works in light and dark (`data-theme=\"dark\"`) and in the Soft style (`data-style=\"soft\"`). The\nmarks and the typed line use the active theme's accent and text colors; the counter is set in the\nnumeric style. Motion is paused for readers who prefer reduced motion — the line is shown whole\nrather than typed."},"231":{"id":"/docs/components/thinking","page_id":"/docs/components/thinking","type":"page","content":"Thinking","breadcrumbs":["Docs","Components","Agent status"],"tags":[],"url":"/docs/components/thinking"},"232":{"id":"/docs/components/thinking-0","page_id":"/docs/components/thinking","tags":[],"type":"text","url":"/docs/components/thinking","content":"The live trace an agent writes as it works, each step turning green as it finishes, then folded away into a summary."},"233":{"id":"/docs/components/thinking-1","page_id":"/docs/components/thinking","type":"heading","tags":[],"url":"/docs/components/thinking#usage","content":"Usage"},"234":{"id":"/docs/components/thinking-2","page_id":"/docs/components/thinking","type":"heading","tags":[],"url":"/docs/components/thinking#properties","content":"Properties"},"235":{"id":"/docs/components/thinking-3","page_id":"/docs/components/thinking","type":"heading","tags":[],"url":"/docs/components/thinking#theming","content":"Theming"},"236":{"id":"/docs/components/thinking-4","page_id":"/docs/components/thinking","tags":[],"type":"text","url":"/docs/components/thinking","content":"A thinking trace is the reasoning log an agent writes as it works. Each step arrives on a line that\nspins while it runs and turns into a green check once it finishes, with what it found written under\nit and how long it took at its right. The header counts seconds while it runs; once the last step\nlands it becomes a summary of the work and the trace folds itself away."},"237":{"id":"/docs/components/thinking-5","page_id":"/docs/components/thinking","tags":[],"type":"text","url":"/docs/components/thinking#properties","content":"| Name    | Type             | Description                                                                                                                           |\n| ------- | ---------------- | ------------------------------------------------------------------------------------------------------------------------------------- |\n| `steps` | `ThinkingStep[]` | The steps the agent has taken so far. Each has a `label`, a `state` of `running`, `retry` or `done`, an optional `result` and `time`. |","table":"table-0"},"238":{"id":"/docs/components/thinking-6","page_id":"/docs/components/thinking","tags":[],"type":"text","url":"/docs/components/thinking#properties","content":"| Name      | Type      | Description                                                |\n| --------- | --------- | ---------------------------------------------------------- |\n| `running` | `boolean` | Spins, counts seconds and keeps the trace open while true. |","table":"table-0"},"239":{"id":"/docs/components/thinking-7","page_id":"/docs/components/thinking","tags":[],"type":"text","url":"/docs/components/thinking#properties","content":"| Name      | Type     | Description                                                  |\n| --------- | -------- | ------------------------------------------------------------ |\n| `seconds` | `number` | Seconds to show. Leave it out to let it count while running. |","table":"table-0"},"240":{"id":"/docs/components/thinking-8","page_id":"/docs/components/thinking","tags":[],"type":"text","url":"/docs/components/thinking#properties","content":"| Name    | Type     | Description                                                 |\n| ------- | -------- | ----------------------------------------------------------- |\n| `title` | `string` | The header while it runs, like \"Checking the pricing page\". |","table":"table-0"},"241":{"id":"/docs/components/thinking-9","page_id":"/docs/components/thinking","tags":[],"type":"text","url":"/docs/components/thinking#properties","content":"| Name      | Type     | Description                                                  |\n| --------- | -------- | ------------------------------------------------------------ |\n| `summary` | `string` | The header once it is done. Defaults to the number of steps. |","table":"table-0"},"242":{"id":"/docs/components/thinking-10","page_id":"/docs/components/thinking","tags":[],"type":"text","url":"/docs/components/thinking#properties","content":"| Name               | Type      | Description                                      |\n| ------------------ | --------- | ------------------------------------------------ |\n| `collapseWhenDone` | `boolean` | Folds the trace away a moment after it finishes. |","table":"table-0"},"243":{"id":"/docs/components/thinking-11","page_id":"/docs/components/thinking","tags":[],"type":"text","url":"/docs/components/thinking#properties","content":"| Name                   | Type      | Description                                                              |\n| ---------------------- | --------- | ------------------------------------------------------------------------ |\n| `open` / `defaultOpen` | `boolean` | Whether the trace is open. Leave `open` out to let the header toggle it. |","table":"table-0"},"244":{"id":"/docs/components/thinking-12","page_id":"/docs/components/thinking","tags":[],"type":"text","url":"/docs/components/thinking#theming","content":"Works in light and dark (`data-theme=\"dark\"`) and in the Soft style (`data-style=\"soft\"`). The\nrunning step turns in the accent with a soft halo, finished steps and the rail between them turn\ngreen, and a slow step waits in amber. In Blueprint the marks are squared off and the result writes\nin with a plain fade instead of a blur."},"245":{"id":"/docs/components/toast","page_id":"/docs/components/toast","type":"page","content":"Toast","breadcrumbs":["Docs","Components","Agent status"],"tags":[],"url":"/docs/components/toast"},"246":{"id":"/docs/components/toast-0","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast","content":"One toast at a time — a new one rises in while the last one slips away."},"247":{"id":"/docs/components/toast-1","page_id":"/docs/components/toast","type":"heading","tags":[],"url":"/docs/components/toast#usage","content":"Usage"},"248":{"id":"/docs/components/toast-2","page_id":"/docs/components/toast","type":"heading","tags":[],"url":"/docs/components/toast#properties","content":"Properties"},"249":{"id":"/docs/components/toast-3","page_id":"/docs/components/toast","type":"heading","tags":[],"url":"/docs/components/toast#theming","content":"Theming"},"250":{"id":"/docs/components/toast-4","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast","content":"A toast is a short message on a surface. Its `tone` picks the icon and colour — `loading` spins —\nand it takes a `title`, an optional `description` and an optional `action` button. Pass a new `id`\nto slide a new toast in and the old one away; keep the same `id` to change the text in place."},"251":{"id":"/docs/components/toast-5","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#properties","content":"| Name    | Type                | Description                            |\n| ------- | ------------------- | -------------------------------------- |\n| `toast` | `ToastData \\| null` | The toast to show, or `null` for none. |","table":"table-0"},"252":{"id":"/docs/components/toast-6","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#properties","content":"| Name        | Type           | Description                                              |\n| ----------- | -------------- | -------------------------------------------------------- |\n| `onDismiss` | `(id) => void` | Called by the close button. The toast leaves either way. |","table":"table-0"},"253":{"id":"/docs/components/toast-7","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#properties","content":"| Name       | Type               | Description                                                                           |\n| ---------- | ------------------ | ------------------------------------------------------------------------------------- |\n| `toast.id` | `string \\| number` | A new id slides a new toast in and the old one away. Keep it to change text in place. |","table":"table-0"},"254":{"id":"/docs/components/toast-8","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#properties","content":"| Name         | Type                                  | Description                                     |\n| ------------ | ------------------------------------- | ----------------------------------------------- |\n| `toast.tone` | `success \\| error \\| info \\| loading` | Picks the icon and its colour. `loading` spins. |","table":"table-0"},"255":{"id":"/docs/components/toast-9","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#properties","content":"| Name          | Type     | Description          |\n| ------------- | -------- | -------------------- |\n| `toast.title` | `string` | The bold first line. |","table":"table-0"},"256":{"id":"/docs/components/toast-10","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#properties","content":"| Name                | Type     | Description                                                   |\n| ------------------- | -------- | ------------------------------------------------------------- |\n| `toast.description` | `string` | The quieter line under the title. Crossfades when it changes. |","table":"table-0"},"257":{"id":"/docs/components/toast-11","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#properties","content":"| Name           | Type                                                           | Description                                           |\n| -------------- | -------------------------------------------------------------- | ----------------------------------------------------- |\n| `toast.action` | `{ label; onClick; variant?: ghost \\| primary \\| ink; busy? }` | A button before the close button, like Undo or Retry. |","table":"table-0"},"258":{"id":"/docs/components/toast-12","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#theming","content":"Works in light and dark (`data-theme=\"dark\"`) and in the Soft style (`data-style=\"soft\"`). The card\nsits on a surface with the toast shadow and its tone tints come from the theme tokens, so it reads\nagainst the dark stage; in Soft the card and its buttons are rounder."},"259":{"id":"/docs/components/tooltip","page_id":"/docs/components/tooltip","type":"page","content":"Tooltip","breadcrumbs":["Docs","Components","Forms and inputs"],"tags":[],"url":"/docs/components/tooltip"},"260":{"id":"/docs/components/tooltip-0","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip","content":"A toolbar whose labels wait a moment, then follow the pointer instantly between buttons, with a richer hover card for people."},"261":{"id":"/docs/components/tooltip-1","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#usage","content":"Usage"},"262":{"id":"/docs/components/tooltip-2","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#properties","content":"Properties"},"263":{"id":"/docs/components/tooltip-3","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#theming","content":"Theming"},"264":{"id":"/docs/components/tooltip-4","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip","content":"A tooltip is the label that waits a moment under a toolbar button, then follows the pointer\ninstantly as it moves between them. Buttons come in `groups` with a line between, each with a `tip`\nand an optional shortcut (`kbd`). Avatars at the end get a richer card instead — a person's name,\nrole and what they are doing now, with an agent shown by its thinking dots."},"265":{"id":"/docs/components/tooltip-5","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#properties","content":"| Name     | Type              | Description                                                                                                      |\n| -------- | ----------------- | ---------------------------------------------------------------------------------------------------------------- |\n| `groups` | `TooltipTool[][]` | The toolbar's buttons, in groups with a line between. Each tool is `{ key, icon, label, tip?, kbd?, onClick? }`. |","table":"table-0"},"266":{"id":"/docs/components/tooltip-6","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#properties","content":"| Name     | Type              | Description                                                                                                      |\n| -------- | ----------------- | ---------------------------------------------------------------------------------------------------------------- |\n| `people` | `TooltipPerson[]` | Avatars at the end. Each is `{ key, initials, color, name, role, status, working? }`; hovering one shows a card. |","table":"table-0"},"267":{"id":"/docs/components/tooltip-7","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#properties","content":"| Name   | Type        | Description                     |\n| ------ | ----------- | ------------------------------- |\n| `note` | `ReactNode` | A quiet line under the toolbar. |","table":"table-0"},"268":{"id":"/docs/components/tooltip-8","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#properties","content":"| Name        | Type     | Description                                                      |\n| ----------- | -------- | ---------------------------------------------------------------- |\n| `cardDelay` | `number` | How long a person card waits before it shows. Defaults to `300`. |","table":"table-0"},"269":{"id":"/docs/components/tooltip-9","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#properties","content":"| Name      | Type             | Description                                                                          |\n| --------- | ---------------- | ------------------------------------------------------------------------------------ |\n| `openTip` | `string \\| null` | Shows this tool's tip by key, as if hovered. Leave it out to let the pointer decide. |","table":"table-0"},"270":{"id":"/docs/components/tooltip-10","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#properties","content":"| Name       | Type             | Description                                     |\n| ---------- | ---------------- | ----------------------------------------------- |\n| `openCard` | `string \\| null` | Shows this person's card by key, as if hovered. |","table":"table-0"},"271":{"id":"/docs/components/tooltip-11","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#properties","content":"A tool's `tip` overrides its `label` in the tooltip, so set it only when the tip should say more\nthan the button's name; the `kbd` shortcut is shown after it. A person's `working: true` swaps the\ngreen status dot for the agent's thinking dots."},"272":{"id":"/docs/components/tooltip-12","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#theming","content":"Works in light and dark (`data-theme=\"dark\"`) and in the Soft style (`data-style=\"soft\"`). In\nBlueprint the bar and card are squared off with hairline borders; in Soft they are rounded panels.\nThe tooltip itself and the avatar colours (`--dm-av-*`) come from the theme, so they stay legible on\neither background."},"273":{"id":"/docs/components/trace-view","page_id":"/docs/components/trace-view","type":"page","content":"Trace view","breadcrumbs":["Docs","Components","Agent status"],"tags":[],"url":"/docs/components/trace-view"},"274":{"id":"/docs/components/trace-view-0","page_id":"/docs/components/trace-view","tags":[],"type":"text","url":"/docs/components/trace-view","content":"One agent run as an observability waterfall — every span on a shared time axis, nested under the span that started it, with its tokens and latency."},"275":{"id":"/docs/components/trace-view-1","page_id":"/docs/components/trace-view","type":"heading","tags":[],"url":"/docs/components/trace-view#usage","content":"Usage"},"276":{"id":"/docs/components/trace-view-2","page_id":"/docs/components/trace-view","type":"heading","tags":[],"url":"/docs/components/trace-view#properties","content":"Properties"},"277":{"id":"/docs/components/trace-view-3","page_id":"/docs/components/trace-view","type":"heading","tags":[],"url":"/docs/components/trace-view#theming","content":"Theming"},"278":{"id":"/docs/components/trace-view-4","page_id":"/docs/components/trace-view","tags":[],"type":"text","url":"/docs/components/trace-view","content":"A trace view lays one agent run out as a waterfall. Every span — an LLM call, a tool call, a\nretrieval, a sub-agent — sits on a shared time axis, nested under the span that started it with a\ntree's guides. Each kind has its own colour, counted in the key. While the run streams, a playhead\nmarks now and running bars glow at their leading edge; a tool call that runs over its budget turns\namber and hatched and is tagged slow. Open any span to see where it sat in the run, its input, its\noutput, its latency and its tokens."},"279":{"id":"/docs/components/trace-view-5","page_id":"/docs/components/trace-view","tags":[],"type":"text","url":"/docs/components/trace-view#properties","content":"| Name    | Type     | Description                                 |\n| ------- | -------- | ------------------------------------------- |\n| `title` | `string` | The run's name, shown over the status line. |","table":"table-0"},"280":{"id":"/docs/components/trace-view-6","page_id":"/docs/components/trace-view","tags":[],"type":"text","url":"/docs/components/trace-view#properties","content":"| Name    | Type          | Description                                                            |\n| ------- | ------------- | ---------------------------------------------------------------------- |\n| `spans` | `TraceSpan[]` | The run's top spans, usually one root with everything nested under it. |","table":"table-0"},"281":{"id":"/docs/components/trace-view-7","page_id":"/docs/components/trace-view","tags":[],"type":"text","url":"/docs/components/trace-view#properties","content":"| Name   | Type     | Description                                                                                                                                   |\n| ------ | -------- | --------------------------------------------------------------------------------------------------------------------------------------------- |\n| `time` | `number` | Seconds into the run while it streams in. Spans that start later stay hidden, running ones reach this far. Leave it out once the run is over. |","table":"table-0"},"282":{"id":"/docs/components/trace-view-8","page_id":"/docs/components/trace-view","tags":[],"type":"text","url":"/docs/components/trace-view#properties","content":"| Name   | Type     | Description                                                                               |\n| ------ | -------- | ----------------------------------------------------------------------------------------- |\n| `axis` | `number` | Seconds the time axis covers. Defaults to the run's length, rounded up to a whole second. |","table":"table-0"},"283":{"id":"/docs/components/trace-view-9","page_id":"/docs/components/trace-view","tags":[],"type":"text","url":"/docs/components/trace-view#properties","content":"| Name        | Type     | Description                                                                              |\n| ----------- | -------- | ---------------------------------------------------------------------------------------- |\n| `slowAfter` | `number` | A tool call longer than this many seconds turns amber and is tagged slow. Defaults to 2. |","table":"table-0"},"284":{"id":"/docs/components/trace-view-10","page_id":"/docs/components/trace-view","tags":[],"type":"text","url":"/docs/components/trace-view#properties","content":"| Name     | Type     | Description                                                                                |\n| -------- | -------- | ------------------------------------------------------------------------------------------ |\n| `status` | `string` | Overrides the status line. Defaults to \"Running · 4 spans\", then \"Done · 7 spans, 1 slow\". |","table":"table-0"},"285":{"id":"/docs/components/trace-view-11","page_id":"/docs/components/trace-view","tags":[],"type":"text","url":"/docs/components/trace-view#properties","content":"| Name       | Type     | Description                                                                        |\n| ---------- | -------- | ---------------------------------------------------------------------------------- |\n| `selected` | `string` | The id of the open span, whose details show under the waterfall. null closes them. |","table":"table-0"},"286":{"id":"/docs/components/trace-view-12","page_id":"/docs/components/trace-view","tags":[],"type":"text","url":"/docs/components/trace-view#properties","content":"| Name                                  | Type       | Description                                                           |\n| ------------------------------------- | ---------- | --------------------------------------------------------------------- |\n| `onSelectedChange` / `selectedChange` | `callback` | Fires with the id of the span opened, or null when the details close. |","table":"table-0"},"287":{"id":"/docs/components/trace-view-13","page_id":"/docs/components/trace-view","tags":[],"type":"text","url":"/docs/components/trace-view#properties","content":"A `TraceSpan` has an `id`, a `name`, a `kind` (agent, llm, tool, or retrieval), a `start` and\n`duration` in seconds, optional `tokens`, optional `input` and `output` strings, and optional\n`children`. An agent span without its own token count adds up every span under it."},"288":{"id":"/docs/components/trace-view-14","page_id":"/docs/components/trace-view","tags":[],"type":"text","url":"/docs/components/trace-view#theming","content":"Works in light and dark (`data-theme=\"dark\"`) and in the Soft style (`data-style=\"soft\"`). In\nBlueprint the bars square off and running bars switch from a sweeping sheen to a steady stripe. Each\nkind keeps its colour from the chart palette; a slow bar is amber and hatched in every theme."},"289":{"id":"/docs/components/web-search","page_id":"/docs/components/web-search","type":"page","content":"Web search","breadcrumbs":["Docs","Components","Agent status"],"tags":[],"url":"/docs/components/web-search"},"290":{"id":"/docs/components/web-search-0","page_id":"/docs/components/web-search","tags":[],"type":"text","url":"/docs/components/web-search","content":"The agent's web searches as a trail — each query and what came back, each page read, skimmed or skipped and why, and an answer whose citations light their pages."},"291":{"id":"/docs/components/web-search-1","page_id":"/docs/components/web-search","type":"heading","tags":[],"url":"/docs/components/web-search#usage","content":"Usage"},"292":{"id":"/docs/components/web-search-2","page_id":"/docs/components/web-search","type":"heading","tags":[],"url":"/docs/components/web-search#properties","content":"Properties"},"293":{"id":"/docs/components/web-search-3","page_id":"/docs/components/web-search","type":"heading","tags":[],"url":"/docs/components/web-search#theming","content":"Theming"},"294":{"id":"/docs/components/web-search-4","page_id":"/docs/components/web-search","tags":[],"type":"text","url":"/docs/components/web-search","content":"Web search shows an agent researching out loud. Each query is a row with how many results came\nback and how long it took; a query that finds nothing is asked again in other words. Under each\nquery sit the pages it opened, each marked Read, Skimmed, or Skipped with the reason (paywall,\nblocked, timeout). Once the run is done the trail folds to one line and the answer streams in,\nits bracketed numbers pointing back at the pages that back them up."},"295":{"id":"/docs/components/web-search-5","page_id":"/docs/components/web-search","tags":[],"type":"text","url":"/docs/components/web-search#properties","content":"| Name      | Type         | Description                                                                                                                          |\n| --------- | ------------ | ------------------------------------------------------------------------------------------------------------------------------------ |\n| `queries` | `WebQuery[]` | The searches, in order. Each has a key, the query text, a status, a result count, a time, an optional rewritten flag, and its pages. |","table":"table-0"},"296":{"id":"/docs/components/web-search-6","page_id":"/docs/components/web-search","tags":[],"type":"text","url":"/docs/components/web-search#properties","content":"| Name   | Type      | Description                                                                    |\n| ------ | --------- | ------------------------------------------------------------------------------ |\n| `done` | `boolean` | True once searching and reading are over. The trail folds to its summary line. |","table":"table-0"},"297":{"id":"/docs/components/web-search-7","page_id":"/docs/components/web-search","tags":[],"type":"text","url":"/docs/components/web-search#properties","content":"| Name     | Type     | Description                                                                                                 |\n| -------- | -------- | ----------------------------------------------------------------------------------------------------------- |\n| `answer` | `string` | The answer, with sources cited as numbers in brackets. Each number points at the page with that cite value. |","table":"table-0"},"298":{"id":"/docs/components/web-search-8","page_id":"/docs/components/web-search","tags":[],"type":"text","url":"/docs/components/web-search#properties","content":"| Name   | Type      | Description                                                           |\n| ------ | --------- | --------------------------------------------------------------------- |\n| `open` | `boolean` | Whether the trail is open. Left out, it folds once `done` turns true. |","table":"table-0"},"299":{"id":"/docs/components/web-search-9","page_id":"/docs/components/web-search","tags":[],"type":"text","url":"/docs/components/web-search#properties","content":"| Name                          | Type       | Description                               |\n| ----------------------------- | ---------- | ----------------------------------------- |\n| `onOpenChange` / `openChange` | `callback` | Fires when the trail is opened or closed. |","table":"table-0"},"300":{"id":"/docs/components/web-search-10","page_id":"/docs/components/web-search","tags":[],"type":"text","url":"/docs/components/web-search#properties","content":"| Name   | Type      | Description                                            |\n| ------ | --------- | ------------------------------------------------------ |\n| `bare` | `boolean` | Without the panel, for a chat stream. True by default. |","table":"table-0"},"301":{"id":"/docs/components/web-search-11","page_id":"/docs/components/web-search","tags":[],"type":"text","url":"/docs/components/web-search#properties","content":"A `WebPage` has a `title`, a `domain`, an optional `date`, a `status` (reading, read, skimmed,\npaywall, blocked, or timeout), and an optional `cite` number the answer refers to it by."},"302":{"id":"/docs/components/web-search-12","page_id":"/docs/components/web-search","tags":[],"type":"text","url":"/docs/components/web-search#theming","content":"Works in light and dark (`data-theme=\"dark\"`) and in the Soft style (`data-style=\"soft\"`). Skipped\npages dim and their tag turns amber; a running page shows a spinner. The site initials stack on the\nheader, and hovering a citation lights the page that backs it up along with its site mark."},"303":{"id":"/docs","page_id":"/docs","type":"page","content":"Introduction","breadcrumbs":["Docs"],"tags":[],"url":"/docs"},"304":{"id":"/docs-0","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"Native UI components for AI-agent products, in four frameworks."},"305":{"id":"/docs-1","page_id":"/docs","type":"heading","tags":[],"url":"/docs#four-frameworks-one-design","content":"Four frameworks, one design"},"306":{"id":"/docs-2","page_id":"/docs","type":"heading","tags":[],"url":"/docs#theming","content":"Theming"},"307":{"id":"/docs-3","page_id":"/docs","type":"heading","tags":[],"url":"/docs#sections","content":"Sections"},"308":{"id":"/docs-4","page_id":"/docs","type":"heading","tags":[],"url":"/docs#get-started","content":"Get started"},"309":{"id":"/docs-5","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"**Visuno** is an open-source UI component library for building agent interfaces. Every component\nships natively for **Vanilla JS**, **React**, **Angular**, and **Flutter**, built from a single\nshared set of design tokens — so a component looks and behaves the same wherever you use it."},"310":{"id":"/docs-6","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"Each component in these docs has a **live preview** you can toggle between light/dark and the two\nstyles, plus the code for all four frameworks side by side."},"311":{"id":"/docs-7","page_id":"/docs","tags":[],"type":"text","url":"/docs#four-frameworks-one-design","content":"| Framework      | Form                                              |\n| -------------- | ------------------------------------------------- |\n| **Vanilla JS** | Plain HTML + CSS + JS — no build step, drop it in |","table":"table-0"},"312":{"id":"/docs-8","page_id":"/docs","tags":[],"type":"text","url":"/docs#four-frameworks-one-design","content":"| Framework | Form                                  |\n| --------- | ------------------------------------- |\n| **React** | `.tsx` components (requires React 19) |","table":"table-0"},"313":{"id":"/docs-9","page_id":"/docs","tags":[],"type":"text","url":"/docs#four-frameworks-one-design","content":"| Framework   | Form                                                  |\n| ----------- | ----------------------------------------------------- |\n| **Angular** | Standalone components (`dm-*` selectors, Angular 17+) |","table":"table-0"},"314":{"id":"/docs-10","page_id":"/docs","tags":[],"type":"text","url":"/docs#four-frameworks-one-design","content":"| Framework   | Form                                  |\n| ----------- | ------------------------------------- |\n| **Flutter** | Dart widgets, themed to match the web |","table":"table-0"},"315":{"id":"/docs-11","page_id":"/docs","tags":[],"type":"text","url":"/docs#four-frameworks-one-design","content":"The Vanilla and React versions are the reference; Angular and Flutter are native ports that mirror\nthe same props and behavior."},"316":{"id":"/docs-12","page_id":"/docs","tags":[],"type":"text","url":"/docs#theming","content":"Every component responds to the same two switches, so your whole UI changes at once:"},"317":{"id":"/docs-13","page_id":"/docs","tags":[],"type":"text","url":"/docs#theming","content":"**Dark mode** — `data-theme=\"dark\"` on a parent element (web); `Brightness.dark` in the Flutter\ntheme."},"318":{"id":"/docs-14","page_id":"/docs","tags":[],"type":"text","url":"/docs#theming","content":"**Style** — the default **Blueprint** style, or **Soft** via `data-style=\"soft\"` (web). Blueprint\nis crisp and squared; Soft is rounded and plush."},"319":{"id":"/docs-15","page_id":"/docs","tags":[],"type":"text","url":"/docs#theming","content":"Design tokens (`--dm-*` on the web, `DmColors`/`DmSpace`/`DmRadius` in Flutter) drive every color,\nspace, radius, and motion — change a token once and it flows everywhere."},"320":{"id":"/docs-16","page_id":"/docs","tags":[],"type":"text","url":"/docs#se